+function accessTicketKey_(value) {
+  return String(value || '').trim().normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
+}
+
+// La marca false domina duplicados y alias; nunca convierte una tarifa en cero.
+function accessTicketAvailability_(types, configurationError) {
+  const disabled = Object.create(null);
+  let invalid = Boolean(configurationError);
+  const entries = Array.isArray(types) ? types : [];
+  entries.forEach(t => {
+    if (!t || typeof t !== 'object' || Array.isArray(t)) { invalid = true; return; }
+    if (Object.prototype.hasOwnProperty.call(t, 'enabled')) {
+      if (typeof t.enabled !== 'boolean' || typeof t.id !== 'string' || !accessTicketKey_(t.id)) { invalid = true; return; }
+      if (t.enabled === false) disabled[accessTicketKey_(t.id)] = true;
+    }
+  });
+  // Los nombres también son aceptados por el backend histórico como tipo.
+  let changed = true;
+  while (changed) {
+    changed = false;
+    entries.forEach(t => {
+      if (!t || typeof t !== 'object') return;
+      const id = accessTicketKey_(t.id);
+      const name = accessTicketKey_(t.name);
+      if (disabled[id] || disabled[name]) {
+        [id, name].filter(Boolean).forEach(key => {
+          if (!disabled[key]) { disabled[key] = true; changed = true; }
+        });
+      }
+    });
+  }
+  return { disabled, invalid };
+}
+
+function accessConfiguredTicketTypes_(row) {
+  const types = [
+    { id: 'General', name: 'General (1 Asistente)', price: typeof row[4] === 'number' ? row[4] : (parseFloat(row[4]) || 0), persons: 1 },
+    { id: 'Pareja', name: 'Pareja (2 Asistentes)', price: typeof row[5] === 'number' ? row[5] : (parseFloat(row[5]) || 0), persons: 2 },
+    { id: 'Trío', name: 'Trío (3 Asistentes)', price: typeof row[6] === 'number' ? row[6] : (parseFloat(row[6]) || 0), persons: 3 }
+  ];
+  const notes = String(row[12] || '').trim();
+  if (notes.startsWith('[')) {
+    try {
+      const custom = JSON.parse(notes);
+      if (!Array.isArray(custom)) throw new Error('Array requerido');
+      types.push.apply(types, custom);
+    } catch (e) {
+      throw accessTicketPolicyError_('ACCESS_TICKET_POLICY_INVALID', 'La configuración de tipos de entrada no es válida.');
+    }
+  }
+  if (accessTicketAvailability_(types).invalid) {
+    throw accessTicketPolicyError_('ACCESS_TICKET_POLICY_INVALID', 'enabled debe ser booleano y tener un id de tipo.');
+  }
+  return types;
+}
+
+function accessTicketPolicyError_(code, message) {
+  const err = new Error(code + ': ' + message);
+  err.code = code;
+  err.status = 400;
+  return err;
+}
