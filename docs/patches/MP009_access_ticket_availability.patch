+    STATE:{accessSelectedType:'Trío', accessSalesChannel:'TAQUILLA_DOMUS', accessWardrobeQty:1, activeActivity:event.name, eventsList:[event]},
+    $:element, getActiveEvent:()=>event, escapeHtml:String, DEFAULT_EVENTS:[],
