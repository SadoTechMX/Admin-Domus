+const frontSource = frontRanges.map(([a,b]) => section(app,a,b)).join('\n');
+const standard = [
+  { id:'General', name:'General (1 Asistente)', price:137, persons:1 },
+  { id:'Pareja', name:'Pareja (2 Asistentes)', price:251, persons:2 },
+  { id:'Trío', name:'Trío (3 Asistentes)', price:389, persons:3 }
+];
+const marker = { id:'Trío', name:'Trío (3 Asistentes)', price:389, persons:3, enabled:false };
+function makeEvent(extra = [marker]) {
