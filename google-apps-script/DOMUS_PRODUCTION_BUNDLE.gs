/**
 * Crea una sesión autenticada en el servidor vinculada a un rol y dispositivo
 */
function authCreateSession(requestedRole, deviceId, operator, credential) {
  const cleanRole = (requestedRole && CONFIG.roles[requestedRole.toUpperCase()]) ? requestedRole.toUpperCase() : 'CAJA';
  const cleanDevice = String(deviceId || 'DEV-ANON').trim();
  const cleanOperator = String(operator || 'Operador').trim();
  const email = String(Session.getActiveUser().getEmail() || '').toLowerCase();
  const manager = CONFIG.managers.includes(email);
  if (!CONFIG.roles[cleanRole] || !deviceId || !operator) throw new Error('AUTH_INPUT_REQUIRED');
  const secret = PropertiesService.getScriptProperties().getProperty('DOMUS_STATION_SECRET_' + cleanRole);
  if (!manager) {
    // A role claim is never an authentication credential. Managers use verified Workspace identity.
    if (['ADMIN','GERENCIA'].includes(cleanRole) || !secret || String(credential || '') !== secret) {
      throw new Error('Acceso denegado: autentica la estación con su credencial de servidor.');
    }
  }
  const token = 'DOMUS-SES-' + Utilities.getUuid();
  
  const session = {
    token: token,
    role: cleanRole,
    deviceId: cleanDevice,
    operator: cleanOperator,
    principal: manager ? email : 'STATION:'+cleanDevice,
    created: Date.now(),
    expires: Date.now() + (CONFIG.sessionDurationHours * 3600 * 1000)
  };

  const cache = CacheService.getScriptCache();
  cache.put('ses:' + token, JSON.stringify(session), 21600); // 6 horas en cache rápido
  PropertiesService.getScriptProperties().setProperty('ses:' + token, JSON.stringify(session));

  return session;
}

/**
 * Valida de forma estricta la sesión del servidor (Zero-Trust)
 * REGLA DE ORO: El rol se determina EXCLUSIVAMENTE a partir de la sesión en servidor.
 * Si el cliente manipula el payload para pretender ser 'ADMIN' o 'CAJA'
 * teniendo una sesión de 'BARRA', la solicitud es rechazada inmediatamente.
 */
function authValidateAction(action, sessionToken, clientClaimedRole, clientDeviceId) {
  const allowedRoles = ACTION_PERMISSIONS[action];
  
  // Acciones de consulta abiertas (ping, estado básico)
  if (['health','ping','authCrearSesion'].includes(action)) {
    return { ok: true, role: 'PUBLIC', operator: 'Público', deviceId: clientDeviceId };
  }

  if (!allowedRoles) throw new Error('Acceso denegado: acción no autorizada.');

  // 1. Verificar existencia de token de sesión
  if (!sessionToken || typeof sessionToken !== 'string') {
    // Si no hay token de sesión, rechazar cualquier mutación
    throw new Error(`Acceso denegado: Se requiere un token de sesión activo para ejecutar '${action}'. Inicia sesión en la estación.`);
  }

  // 2. Recuperar la sesión guardada en el servidor (Cache + Properties)
  const cache = CacheService.getScriptCache();
  const rawSession = cache.get('ses:' + sessionToken) || PropertiesService.getScriptProperties().getProperty('ses:' + sessionToken);
  
  if (!rawSession) {
    throw new Error('Sesión inválida o expirada. Por favor autentica nuevamente la estación.');
  }

  let session;
  try {
    session = JSON.parse(rawSession);
  } catch (e) {
    throw new Error('Error de integridad en los datos de sesión del servidor.');
  }

  // 3. Validar expiración de sesión
  if (session.expires && session.expires < Date.now()) {
    throw new Error('La sesión de la estación ha caducado. Vuelve a iniciar sesión.');
  }

  if (!session.expires || !clientDeviceId || session.deviceId !== clientDeviceId) throw new Error('Sesión inválida para este dispositivo.');
  const serverAssignedRole = session.role;

  // 4. Detección de Manipulación en Cliente (Anti-Tampering):
  // Si el cliente envió explícitamente un rol reclamado en el payload (ej. "ADMIN")
  // y no coincide con el rol asignado en la sesión de servidor (ej. "BARRA"), abortar.
  if (clientClaimedRole && String(clientClaimedRole).toUpperCase() !== serverAssignedRole) {
    console.warn(`[SECURITY ALERT] Intento de escalación de privilegios: Dispositivo ${clientDeviceId || session.deviceId} con sesión '${serverAssignedRole}' intentó reclamar rol '${clientClaimedRole}' para la acción '${action}'.`);
    throw new Error(`Violación de seguridad: El rol declarado '${clientClaimedRole}' discrepa del rol autenticado '${serverAssignedRole}'. Petición bloqueada.`);
  }

  // 5. Validar que el rol del servidor tenga autorización para la acción requerida
  if (!allowedRoles.includes(serverAssignedRole)) {
    throw new Error(`Acceso denegado: El rol autenticado '${serverAssignedRole}' no tiene autorización para ejecutar '${action}'. Roles autorizados: [${allowedRoles.join(', ')}].`);
  }
  if(['prepararLimiteHistorico','registrarLimiteHistorico','transferenciasPendientes','prepararResolucionTransferencia','cancelarTransferenciaNoRecibida','prepararVinculoPagoExistente','vincularPagoExistente','confirmarTransferencia','corteZCerrar'].includes(action) && !CONFIG.managers.includes(session.principal)) {
    const err=new Error('Sesión inválida para esta operación: renueva la identidad de Gerencia.');
    err.code='AUTH_PRINCIPAL_REQUIRED';err.status=401;throw err;
  }

  return {
    ok: true,
    role: serverAssignedRole,
    operator: session.operator || 'Operador',
    principal: session.principal || '',
    deviceId: session.deviceId || clientDeviceId || 'DEV-ESTACION'
  };
}

let _authContext = null;
function authRequireContext_(action) {
  if (!_authContext || !(ACTION_PERMISSIONS[action] || []).includes(_authContext.role)) {
    throw new Error('Acceso denegado: usa el dispatcher autenticado.');
  }
  return _authContext;
}


// MODULE Idempotency
/**
 * ============================================================================
 * DOMUS OS · IDEMPOTENCY & CONCURRENCY CONTROL (Idempotency.gs)
 * Bloqueo atómico con LockService, vinculación estricta de payload y
 * Ledger transaccional persistente (REQUESTS / TRANSACCIONES_API).
 * ============================================================================
 */

'use strict';

/**
 * Estados del ciclo de vida de una solicitud transaccional
 */
const REQUEST_STATUS = Object.freeze({
  PROCESSING: 'PROCESSING',
  COMPLETED: 'COMPLETED',
  FAILED: 'FAILED',
  REQUIRES_REVIEW: 'REQUIRES_REVIEW'
});

// Root IDs and journal fragment IDs are different namespaces. Do not trim or
// coerce a caller's identity: the exact value is part of the durable binding.
function requestRootIdValid_(id) {
  return typeof id==='string' && !!id && id===id.trim() && id[0]!=='=' &&
    !id.includes('#part:') && !/[\u0000-\u001f\u007f\u2028\u2029]/.test(id);
}
function requestRootIdAssert_(id) {
  if(!requestRootIdValid_(id)) {
    const e=new Error('REQUEST_ID_INVALID: identidad de intención inválida o reservada. Conservar la referencia original para revisión; no sustituirla automáticamente.');
    e.code='REQUEST_ID_INVALID';e.status=422;throw e;
  }
  return id;
}

function requestLedgerError_(message,duplicate) {
  const code=duplicate?'LEDGER_DUPLICATE_REQUIRES_REVIEW':'LEDGER_IDENTITY_REQUIRES_REVIEW';
  const e=new Error(code+': '+message+' Conservar la evidencia original, sin normalizar IDs.');
  e.code=code;e.status=409;return e;
}

// Preserve physical rows and native values. Never cast or trim persisted IDs.
// A malformed identity cannot safely be classified as an unrelated/missing intent.
function requestRows_(sheet) {
  if(!sheet || sheet.getLastRow()<2)return [];
  const range=sheet.getRange(2,1,sheet.getLastRow()-1,8),rows=range.getValues(),formulas=range.getFormulas();
  rows.forEach((row,i)=>{
    if(!row.some(v=>v!=='' && v!==null) && !formulas[i].some(Boolean))return;
    if(formulas[i][0] || !requestRootIdValid_(row[0]))throw requestLedgerError_('Identidad persistida inválida en fila '+(i+2)+'.');
  });
  return rows;
}

function requestRecordEntry_(sheet,id) {
  requestRootIdAssert_(id);
  const found=[];
  requestRows_(sheet).forEach((row,i)=>{if(row[0]===id)found.push({values:row,row:i+2});});
  if(found.length>1)throw requestLedgerError_('Más de una fila para la misma intención.',true);
  return found[0] || null;
}

let _scriptLockDepth = 0;

/**
 * Ejecuta una función dentro de una sección crítica protegida con LockService
 * Garantiza que dos peticiones simultáneas no colisionen ni corrompan el libro
 * Maneja re-entrancia segura: sólo el nivel superior adquiere y libera el script lock físico,
 * evitando que llamadas anidadas (ej. idempotentExecute_ -> cajaSimpleRegistrar) liberen el lock prematuramente.
 */
function withLock_(timeoutMs, fn) {
  const timeout = typeof timeoutMs === 'number' ? timeoutMs : (CONFIG.lockTimeoutMs || 30000);
  const lock = LockService.getScriptLock();
  
  const isTopLevel = (_scriptLockDepth === 0);
  if (isTopLevel) {
    try {
      lock.waitLock(timeout);
    } catch (err) {
      throw new Error('El sistema se encuentra procesando otra transacción concurrente. Por favor reintenta en un momento.');
    }
  }
  _scriptLockDepth++;

  try {
    return fn();
  } finally {
    _scriptLockDepth--;
    if (isTopLevel && _scriptLockDepth === 0) {
      try {
        lock.releaseLock();
      } catch (e) {
        console.warn('Error al liberar candado de Apps Script:', e);
      }
    }
  }
}

/**
 * Genera una representación canónica y determinista de un objeto (JSON con claves ordenadas)
 */
function canonicalJsonStringify_(obj) {
  if (obj === null || typeof obj !== 'object') {
    return JSON.stringify(obj);
  }
  if (Array.isArray(obj)) {
    return '[' + obj.map(canonicalJsonStringify_).join(',') + ']';
  }
  const keys = Object.keys(obj).sort();
  const parts = keys.map(k => JSON.stringify(k) + ':' + canonicalJsonStringify_(obj[k]));
  return '{' + parts.join(',') + '}';
}

/**
 * Calcula un hash criptográfico SHA-256 determinista del contenido de la petición
 */
function computePayloadHash_(payload) {
  try {
    const canonicalStr = canonicalJsonStringify_(payload !== undefined ? payload : null);
    if (typeof Utilities !== 'undefined' && Utilities.computeDigest) {
      const rawHash = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, canonicalStr, Utilities.Charset.UTF_8);
      let hashHex = '';
      for (let i = 0; i < rawHash.length; i++) {
        let b = rawHash[i];
        if (b < 0) b += 256;
        let s = b.toString(16);
        if (s.length === 1) s = '0' + s;
        hashHex += s;
      }
      return hashHex;
    }
    // Fallback simple para tests unitarios locales sin objeto Utilities
    let hash = 0;
    for (let i = 0; i < canonicalStr.length; i++) {
      hash = ((hash << 5) - hash) + canonicalStr.charCodeAt(i);
      hash |= 0;
    }
    return 'sha256-fallback-' + Math.abs(hash).toString(16);
  } catch (e) {
    return 'hash-error-' + Date.now();
  }
}

/**
 * Obtiene o crea la hoja de auditoría de peticiones (REQUESTS / TRANSACCIONES_API)
 */
function getOrCreateRequestsSheet_(spreadsheet) {
  try {
    const ss = spreadsheet || SpreadsheetApp.openById(CONFIG.mainSheetId);
    let sheet = ss.getSheetByName('REQUESTS') || ss.getSheetByName('TRANSACCIONES_API');
    if (!sheet) {
      sheet = ss.insertSheet('REQUESTS');
      const headers = [
        'REQUEST_ID', 'ACTION', 'PAYLOAD_HASH', 'DEVICE_ID',
        'STATUS', 'CREATED_AT', 'COMPLETED_AT', 'RESPONSE'
      ];
      sheet.appendRow(headers);
      sheet.setFrozenRows(1);
      sheet.getRange(1, 1, 1, headers.length).setFontWeight('bold');
    }
    return sheet;
  } catch (e) {
    console.warn('[IDEMPOTENCY] No se pudo acceder/crear hoja REQUESTS:', e);
    return null;
  }
}

/**
 * Busca el registro durable autoritativo en REQUESTS (o su nombre legado).
 * Cache/Properties antiguos sólo sirven para detectar incertidumbre, nunca como ACK.
 */
function findRequestRecord_(cleanReqId, spreadsheet) {
  requestRootIdAssert_(cleanReqId);
  const sheet = getOrCreateRequestsSheet_(spreadsheet);
  if (!sheet) throw new Error('LEDGER_UNAVAILABLE');
  const entry=requestRecordEntry_(sheet,cleanReqId);if(!entry)return null;
  const r=entry.values;
  return {requestId:r[0],action:r[1],payloadHash:r[2],deviceId:r[3],status:r[4],createdAt:r[5],completedAt:r[6],
    response:r[7]?JSON.parse(r[7]):null,sheetRowIndex:entry.row};
}

/**
 * Guarda o actualiza un registro en el ledger (Cache, Properties y Hoja REQUESTS)
 */
function saveRequestRecord_(record, spreadsheet) {
  requestRootIdAssert_(record && record.requestId); // Before sheet creation or any write.
  const sheet = getOrCreateRequestsSheet_(spreadsheet);
  if (!sheet) throw new Error('LEDGER_UNAVAILABLE');
  const entry=requestRecordEntry_(sheet,record.requestId);
  if(record.sheetRowIndex!=null) {
    if(!Number.isInteger(record.sheetRowIndex) || !entry || entry.row!==record.sheetRowIndex)throw requestLedgerError_('La fila original cambió de identidad o posición.');
  } else if(entry)throw requestLedgerError_('No anexar otra fila para una intención existente.',true);
  // The durable ledger is authoritative. No cache can publish completion before Sheets.
  if (!record.sheetRowIndex) record.sheetRowIndex = Math.max(2, sheet.getLastRow() + 1);
  sheet.getRange(record.sheetRowIndex, 1, 1, 8).setValues([[
    record.requestId, record.action, record.payloadHash, record.deviceId,
    record.status, record.createdAt, record.completedAt || '', JSON.stringify(record.response)
  ]]);
  SpreadsheetApp.flush();
}

// Called under the script lock, only when the durable request binding is absent.
// Legacy code could write payments/cache/Properties while swallowing a REQUESTS failure.
// Do not import its receipt or invent a new binding; preserve evidence for reconciliation.
function assertNoUnboundHistory_(requestId, action, m) {
  const props = PropertiesService.getScriptProperties();
  let evidence = props.getProperty('idemp:' + requestId) != null ||
    props.getProperty('cajaSimple:' + requestId) != null ||
    CacheService.getScriptCache().get('idemp:' + requestId) != null || !!journalFind_(requestId, m);
  if (!evidence && action === 'cajaSimpleRegistrar') {
    // An old unsent tab and an old partially written sale can be indistinguishable.
    // New clients use UUIDs; old timestamp POS IDs without a durable binding require review.
    evidence = /^POS-\d{13}-[a-z0-9]+$/i.test(requestId) ||
      dataRows_(m.getSheetByName('COBROS'), 7, 1, 9).some(r => String(r[0]) === 'CAJA-RAPIDA:' + requestId) ||
      dataRows_(m.getSheetByName('COMANDAS'), 7, 1, 13).some(r => {
        if (!r[0]) return false;
        try { const order = JSON.parse(String(r[0])); return order && String(order.batch) === requestId; }
        catch (_) { return String(r[0]).includes(JSON.stringify(requestId)); }
      });
  }
  if (evidence) {
    const err = new Error('IDEMPOTENCY_REQUIRES_REVIEW: evidencia previa sin vínculo durable en REQUESTS. Conserva el ID y concilia antes de cobrar.');
    err.code = 'IDEMPOTENCY_REQUIRES_REVIEW'; err.status = 409; throw err;
  }
}

/**
 * Ejecuta una operación mutativa garantizando:
 * 1. Deduplicación estricta por requestId
 * 2. Vinculación criptográfica de contenido (action + payloadHash + deviceId)
 * 3. Rechazo inmediato con 409 IDEMPOTENCY_KEY_REUSED si un requestId se reutiliza con distinto payload
 * 4. Registro continuo de estados: PROCESSING -> COMPLETED / FAILED / REQUIRES_REVIEW
 */
// In scoped staging custody, these financial handlers only read/build a plan
// before journalCommit_. Keep this list explicit; a handler with earlier writes
// must not enter deferred preparation. Existing bindings never take this path.
let _deferredRequestBinding = null;
function requestBindBeforeJournal_(id,action,m) {
  const binding=_deferredRequestBinding;if(!binding)return;
  if(binding.id!==id || binding.action!==action || binding.book!==m.getId())throw historyError_('Plan ajeno a la intención en preparación.');
  binding.bind();
}
function idempotentExecute_(requestId, action, payload, deviceId, fn) {
  const cleanReqId = requestRootIdAssert_(requestId);
  const currentPayloadHash = computePayloadHash_({ action: action, payload: payload });
  const devId = String(deviceId || '');
  if (!devId) throw new Error('DEVICE_ID_REQUIRED');
  return withLock_(CONFIG.lockTimeoutMs, () => {
    qaRecoveryOperationalGuard_(true);
    if(_deferredRequestBinding)throw historyError_('No se admite otra intención dentro de una preparación pendiente.');
    const m = SpreadsheetApp.openById(CONFIG.mainSheetId);
    const boundary=historyGuardIntent_(m,cleanReqId,action,payload,devId); // Before lookup, ACK, binding or any journal replay.
    const prior = findRequestRecord_(cleanReqId, m);
    if (prior && (prior.payloadHash !== currentPayloadHash || prior.action !== action || prior.deviceId !== devId)) {
      const err = new Error('IDEMPOTENCY_KEY_REUSED'); err.status = 409; err.code = 'IDEMPOTENCY_KEY_REUSED'; throw err;
    }
    if (prior && prior.status === REQUEST_STATUS.COMPLETED) return prior.response;
    if(action==='confirmarTransferencia')transferAssertNotCancelled_(m,payload);
    if (prior) {
      if(action==='registrarLimiteHistorico' && historyNoEffects_(m,[[cleanReqId,action,prior.payloadHash,prior.deviceId,prior.status,prior.createdAt,prior.completedAt,JSON.stringify(prior.response)]]))throw historyError_(prior.response.error,true);
      if(action==='cancelarTransferenciaNoRecibida')transferCancellationReplayGuard_(m,cleanReqId);
      if(action==='vincularPagoExistente')existingPaymentReplayGuard_(m,cleanReqId);
      // A PREPARED delivery can predate the payment guard. Check before any
      // inventory/status replay; completed acknowledgements do not write again.
      if(action==='comandasSimpleAccion') {
        const plan=journalFind_(cleanReqId,m);
        if(plan && plan.data[2]!=='COMPLETED')kdsAssertDeliveryRequest_(payload,m,true);
      }
      if(action==='accesoSimpleRegistrar')accessAssertTransferReplay_(journalFind_(cleanReqId,m));
      const resumed = journalResume_(cleanReqId, action, m);
      if (resumed) {
        prior.status = REQUEST_STATUS.COMPLETED; prior.response = resumed;
        prior.completedAt = new Date().toISOString(); saveRequestRecord_(prior, m); return resumed;
      }
      if(prior.response && prior.response.code==='JOURNEY_VALIDATION_NO_EFFECTS' && prior.response.status===422 &&
          ['turnoAbrir','corteZCerrar','cajaSimpleRegistrar','confirmarTransferencia'].includes(action)) {
        throw journeyReject_(prior.response.error);
      }
      if (action === 'cajaSimpleRegistrar' && prior.response && Number(prior.response.status) === 422 &&
          ['SALE_PHASE_CHANGED_NO_EFFECTS', 'SALE_VALIDATION_REJECTED_NO_EFFECTS'].includes(prior.response.code)) {
        const err = new Error(prior.response.error);
        err.code = prior.response.code; err.status = 422; throw err;
      }
      if(action==='confirmarTransferencia' && prior.response && Number(prior.response.status)===422 &&
          ['TRANSFER_POLICY_REQUIRED_NO_EFFECTS','TRANSFER_REVIEW_INCOMPLETE_NO_EFFECTS'].includes(prior.response.code)) {
        const err=new Error(prior.response.error);err.code=prior.response.code;err.status=422;throw err;
      }
      if(action==='cancelarTransferenciaNoRecibida' && prior.response && prior.response.status===422 && prior.response.code==='TRANSFER_CANCELLATION_VALIDATION_NO_EFFECTS') {
        throw transferCancellationReject_(prior.response.error);
      }
      if(action==='vincularPagoExistente' && prior.response && prior.response.status===422 && prior.response.code==='EXISTING_PAYMENT_VALIDATION_NO_EFFECTS')throw existingPaymentError_(prior.response.error,true);
      // Old code may have written effects before FAILED. Never rerun it blindly.
      const err = new Error('IDEMPOTENCY_REQUIRES_REVIEW: intención previa sin plan recuperable.');
      err.status = 409; err.code = 'IDEMPOTENCY_REQUIRES_REVIEW'; throw err;
    }
    assertNoUnboundHistory_(cleanReqId, action, m);
    if(action==='comandasSimpleAccion')kdsAssertDeliveryRequest_(payload,m,false);
    const record = {requestId: cleanReqId, action: action, payloadHash: currentPayloadHash,
      deviceId: devId, status: REQUEST_STATUS.PROCESSING, createdAt: new Date().toISOString(), response: null};
    const defer=!!(boundary && boundary.result.snapshot.isolation && ['turnoAbrir','corteZCerrar','cajaSimpleRegistrar',
      'confirmarTransferencia','cancelarTransferenciaNoRecibida','vincularPagoExistente','comandasSimpleAccion'].includes(action));
    const binding={id:cleanReqId,action:action,book:m.getId(),started:false,bind:()=>{
      if(binding.started)return;
      binding.started=true; // A write/flush failure is uncertainty, never a safe unbound rejection.
      saveRequestRecord_(record,m);
    }};
    if(defer)_deferredRequestBinding=binding;else saveRequestRecord_(record, m);
    try {
      const output = fn(),result=defer?JSON.parse(JSON.stringify(output)):output;
      if(defer) {
        // Also cover legitimate read-only early returns without journalCommit_.
        historyGuardPrepared_(m,cleanReqId,action,[],JSON.stringify(result));
        binding.bind();
      }
      record.status = REQUEST_STATUS.COMPLETED; record.response = result;
      record.completedAt = new Date().toISOString(); saveRequestRecord_(record, m); return result;
    } catch (err) {
      if(!defer || binding.started) {
        record.status = REQUEST_STATUS.REQUIRES_REVIEW;
        record.response = {error: String(err.message || err), code: err.code || '', status: err.status || 500};
        record.completedAt = new Date().toISOString(); saveRequestRecord_(record, m);
      }
      throw err;
    } finally {
      if(defer)_deferredRequestBinding=null;
    }
  });
}


// MODULE Accounts
/**
 * ============================================================================
 * DOMUS OS · CUSTOMER ACCOUNTS & BALANCES (Accounts.gs)
 * Gestión de saldos de cuentas abiertas, aperturas, autorizaciones y cierres
 * ============================================================================
 */

'use strict';

function accountKey_(ticket) {
  return 'cuenta:' + Utilities.base64EncodeWebSafe(String(ticket));
}

function account_(ticket) {
  const raw = PropertiesService.getScriptProperties().getProperty(accountKey_(ticket));
  return JSON.parse(raw || '{}');
}

function putAccount_(ticket, a) {
  PropertiesService.getScriptProperties().setProperty(accountKey_(ticket), JSON.stringify(a));
}

function posBalanceFast_(x, ticket) {
  const sCaja = x.c || x.m.getSheetByName('CAJA 2');
  const sCobros = x.m.getSheetByName('COBROS');

  const rows = dataRows_(sCaja, 7, 32)
    .filter(r => String(r[1]) === String(ticket) && r[6] && r[15] !== 'Cancelado');

  const total = rows.reduce((n, r) => n + (Number(r[11]) || 0), 0);

  const paid = dataRows_(sCobros, 7, 14)
    .filter(r => r[2] === 'Caja' && String(r[3]) === String(ticket))
    .reduce((n, r) => n + paymentApplied_(r), 0);

  return {
    rows: rows,
    total: posRound_(total),
    paid: posRound_(paid),
    due: posRound_(total - paid)
  };
}

function closeCashAccount_(x, ticket, who) {
  const b = posBalanceFast_(x, ticket);
  if (b.due > 0.01) {
    throw new Error(`No se puede cerrar la cuenta '${ticket}'. Presenta un saldo pendiente de $${b.due.toFixed(2)}.`);
  }

  const a = account_(ticket);
  a.closed = true;
  a.closedBy = who;
  a.closedAt = new Date().toISOString();
  putAccount_(ticket, a);

  return { ok: true, ticket: ticket, message: `Cuenta '${ticket}' cerrada formalmente por ${who}.` };
}

function reopenCashAccount_(ticket, who, reason) {
  if (!reason || !String(reason).trim()) {
    throw new Error('El motivo de reapertura es obligatorio para auditoría.');
  }

  const a = account_(ticket);
  a.closed = false;
  a.events = a.events || [];
  a.events.push({
    action: 'Reabrir',
    who: who,
    reason: String(reason).trim(),
    at: new Date().toISOString()
  });
  putAccount_(ticket, a);

  return { ok: true, ticket: ticket, message: `Cuenta '${ticket}' reabierta con éxito.` };
}


// MODULE Payments
/**
 * ============================================================================
 * DOMUS OS · PAYMENTS & CONCILIATION (Payments.gs)
 * Registro de transacciones en COBROS, validación de medios de pago y folios
 * ============================================================================
 */

'use strict';

function paymentWrites_(sheet, p) {
  schemaColumns_(sheet, ['Folio cobro','Puesto / origen','TICKET / referencia BOL','IMPORTE COBRADO','Revisión','Cobrado aplicado']);
  if (!Number.isFinite(Number(p.amount)) || Number(p.amount) <= 0) throw new Error('Importe inválido.');
  const row = p.row || Math.max(sheet.getLastRow()+1, 7);
  const inputs = {1:p.folio,2:new Date(),3:p.origin,4:p.ticket,5:p.method,6:p.amount,
    7:p.method==='Efectivo'?0:'',9:p.tag,11:p.method==='Transferencia'?'Borrador':'Confirmado',
    12:p.operator,16:p.activity,29:p.tip||0,30:p.received==null?'':p.received,31:p.change==null?'':p.change};
  // Keep semantic columns: H net, M review, N applied, O net applied, never customer/amount shifted.
  inputs[8] = '=F'+row+'-N(G'+row+')';
  inputs[13] = '=IF(K'+row+'="Borrador","TRANSFERENCIA POR VERIFICAR","LISTO")';
  inputs[14] = '=IF(K'+row+'="Confirmado",F'+row+',0)';
  inputs[15] = '=IF(N'+row+'>0,N'+row+'-N(G'+row+'),0)';
  return Object.keys(inputs).map(c => cellWrite_(sheet,row,Number(c),inputs[c],[8,13,14,15].includes(Number(c))));
}

/**
 * Registra un cobro asentado en la hoja maestra COBROS
 */
function recordPaymentTransaction_(m, payload) {
  authRequireContext_('cajaSimpleRegistrar');
  const id=String(payload.requestId || '');
  const folio=payload.folio || 'REC-'+Utilities.getUuid();
  const values=paymentWrites_(m.getSheetByName('COBROS'),Object.assign({},payload,{folio:folio}));
  return journalCommit_(id,'recordPaymentTransaction',m,values,{folio:folio,amount:payload.amount,method:payload.method});
}

// Manual bank review for Caja only. No provider/bank API and no inferred approval.
// Configure only after the owner approves the receiver aliases and review policy.
function transferError_(code, message, status) {
  const err=new Error(code+': '+message);err.code=code;err.status=status || 409;return err;
}

function transferPolicy_() {
  let policy;
  try { policy=JSON.parse(PropertiesService.getScriptProperties().getProperty('DOMUS_TRANSFER_REVIEW_POLICY') || 'null'); } catch(_) {}
  if(!policy || policy.version!==1 || policy.approved!==true || !Array.isArray(policy.receivers) || !policy.receivers.length ||
      policy.receivers.some(v=>typeof v!=='string' || !/^[A-Za-z0-9_-]{1,80}$/.test(v)) || new Set(policy.receivers).size!==policy.receivers.length) {
    throw transferError_('TRANSFER_POLICY_REQUIRED','Configurar cuentas receptoras y revisión bancaria aprobadas.');
  }
  return policy;
}

function transferSheet_(m) {
  const s=m.getSheetByName('COBROS'),expected={'Folio cobro':1,'Puesto / origen':3,'TICKET / referencia BOL':4,'Medio':5,'IMPORTE COBRADO':6,'Folio terminal / evidencia':9,'Cuenta receptora':10,'Estado':11,'Quién cobró':12,'Cobrado aplicado':14};
  const columns=schemaColumns_(s,Object.keys(expected));
  if(Object.keys(expected).some(k=>columns[k]!==expected[k]))throw transferError_('TRANSFER_SCHEMA_REQUIRES_REVIEW','Columnas de cobro incompatibles.');
  return s;
}

// Read-only index: querying delivery permissions must not create a ledger/sheet.
function paymentRequestIndex_(m) {
  const s=m.getSheetByName('REQUESTS') || m.getSheetByName('TRANSACCIONES_API'),index=new Map();
  requestRows_(s).forEach(r=>{const id=r[0];if(!id)return;const list=index.get(id)||[];list.push(r);index.set(id,list);});
  return index;
}

function paymentRequest_(index,id) {
  const rows=index.get(String(id)) || [];
  if(rows.length>1)throw transferError_('PAYMENT_EVIDENCE_REQUIRES_REVIEW','Vínculo financiero duplicado.');
  if(!rows.length)return null;
  const row=rows[0];let result;
  try { result=row[7]?JSON.parse(row[7]):null; } catch(_) { throw transferError_('PAYMENT_EVIDENCE_REQUIRES_REVIEW','Resultado financiero ilegible.'); }
  return {id:row[0],action:String(row[1]),status:String(row[4]),result:result};
}

function transferBankKey_(receiver,reference) {
  return computePayloadHash_({receiver:receiver,bankTransactionId:reference});
}

// Every applied transfer must have a matching durable confirmation. Unknown
// historical transfers require reconciliation; do not silently import their keys.
function transferConfirmedRecords_(m,index) {
  const records=[],sources=new Set(),bankKeys=new Set();
  dataRows_(transferSheet_(m),7,31).forEach(r=>{
    if(r[4]!=='Transferencia' || (String(r[10]).toLowerCase()==='borrador' && !String(r[8]).startsWith('DOMUS_TRANSFER_CONFIRMATION:')))return;
    let meta;try { if(String(r[8]).startsWith('DOMUS_TRANSFER_CONFIRMATION:'))meta=JSON.parse(String(r[8]).slice('DOMUS_TRANSFER_CONFIRMATION:'.length)); } catch(_) {}
    const record=meta && paymentRequest_(index,meta.confirmationRequestId),p=record && record.result;
    if(!meta || meta.version!==1 || !record || record.action!=='confirmarTransferencia' || record.status!=='COMPLETED' || !p || p.ok!==true || p.kind!=='TRANSFER_CONFIRMATION' ||
        p.confirmationRequestId!==record.id || p.receipt!==r[0] || p.ticket!==r[3] || p.method!=='Transferencia' || p.paymentStatus!=='CONFIRMADA' || p.paid!==true || p.verified!==true ||
        p.verificationMode!=='MANUAL_BANK_REVIEW' || !['ADMIN','GERENCIA'].includes(p.verifiedRole) || typeof p.verifiedPrincipal!=='string' || !p.verifiedPrincipal || r[10]!=='Confirmado' ||
        typeof p.amountApplied!=='number' || p.amountApplied<=0 || Number(r[5])!==p.amountApplied || paymentApplied_(r)!==p.amountApplied ||
        p.receiver!==r[9] || p.sourceRequestId!==meta.sourceRequestId || p.sourceReceipt!==meta.sourceReceipt || p.bankKey!==meta.bankKey ||
        p.bankKey!==transferBankKey_(p.receiver,p.bankTransactionId)) {
      throw transferError_('TRANSFER_HISTORY_REQUIRES_REVIEW','Transferencia sin confirmación durable compatible; conciliar sin importar ni duplicar cobros.');
    }
    if(sources.has(p.sourceReceipt) || bankKeys.has(p.bankKey))throw transferError_('TRANSFER_HISTORY_REQUIRES_REVIEW','Confirmación bancaria duplicada.');
    sources.add(p.sourceReceipt);bankKeys.add(p.bankKey);records.push(p);
  });
  return records;
}

function transferSource_(m,index,p) {
  historyGuard_(m,p.sourceRequestId,'transferSource');
  const record=paymentRequest_(index,p.sourceRequestId),source=record && record.result;
  if(!record || record.action!=='cajaSimpleRegistrar' || record.status!=='COMPLETED' || !source || source.ok!==true ||
      source.receipt!==p.sourceReceipt || source.ticket!==p.ticket || source.method!=='Transferencia' || source.paymentStatus!=='PENDIENTE_VERIFICACION' || source.paid!==false || source.verified!==false ||
      typeof source.total!=='number' || source.total<=0)throw transferError_('TRANSFER_SOURCE_REQUIRES_REVIEW','Se requiere el recibo pendiente original de Caja vinculado a REQUESTS.');
  const rows=dataRows_(transferSheet_(m),7,31).filter(r=>r[0]===source.receipt);
  if(rows.length!==1 || rows[0][2]!=='Caja' || rows[0][3]!==source.ticket || rows[0][4]!=='Transferencia' || rows[0][10]!=='Borrador' ||
      Number(rows[0][5])!==source.total || typeof rows[0][13]!=='number' || rows[0][13]!==0 || rows[0][8]!=='CAJA-RAPIDA:'+record.id) {
    throw transferError_('TRANSFER_SOURCE_REQUIRES_REVIEW','El cobro pendiente cambió o no tiene un vínculo único.');
  }
  return source;
}

function transferenciasPendientes() {
  authRequireContext_('transferenciasPendientes');
  let policy;try {policy=transferPolicy_();}catch(e){if(e.code!=='TRANSFER_POLICY_REQUIRED')throw e;policy={receivers:[]};}
  const m=SpreadsheetApp.openById(CONFIG.mainSheetId),index=paymentRequestIndex_(m),cancelled=transferCancellationRecords_(m,index);
  const linked=transferExistingPaymentRecords_(m,index);
  const confirmed=transferConfirmedRecords_(m,index),done=new Set(confirmed.map(p=>p.sourceReceipt).concat(cancelled.map(p=>p.sourceReceipt),linked.map(p=>p.sourceReceipt))),pending=[];
  dataRows_(transferSheet_(m),7,31).forEach(r=>{
    if(r[2]!=='Caja' || r[4]!=='Transferencia' || r[10]!=='Borrador' || done.has(r[0]))return;
    const sourceRequestId=String(r[8]).startsWith('CAJA-RAPIDA:')?String(r[8]).slice('CAJA-RAPIDA:'.length):'';
    const item={sourceRequestId:sourceRequestId,sourceReceipt:r[0],ticket:r[3],amount:Number(r[5])};
    try { const source=transferSource_(m,index,item);pending.push(Object.assign(item,{customer:source.customer,requiresReview:false})); }
    catch(_) { pending.push(Object.assign(item,{requiresReview:true})); }
  });
  return {ok:true,currency:'MXN',verificationMode:'MANUAL_BANK_REVIEW',receivers:policy.receivers,pending:pending,
    cancelled:cancelled.map(c=>({requestId:c.cancellationRequestId,sourceReceipt:c.sourceReceipt,ticket:c.ticket,wasteStatus:c.wasteReview.status,closureBlocked:c.closureBlocked})),
    linked:linked.map(c=>({requestId:c.linkRequestId,sourceReceipt:c.sourceReceipt,ticket:c.ticket,existingPaymentReceipt:c.existingPaymentReceipt,linkedAmount:c.linkedAmount,newCharge:0}))};
}

function confirmarTransferencia(p) {
  authRequireContext_('confirmarTransferencia');
  return withLock_(CONFIG.lockTimeoutMs,()=>{
    const m=SpreadsheetApp.openById(CONFIG.mainSheetId),id=String(p && p.requestId || '');
    const resumed=journalResume_(id,'confirmarTransferencia',m);if(resumed)return resumed;
    let policy;
    try { policy=transferPolicy_(); }
    catch(err) {
      if(err.code==='TRANSFER_POLICY_REQUIRED')throw transferError_('TRANSFER_POLICY_REQUIRED_NO_EFFECTS','Configurar revisión bancaria aprobada antes de crear otra intención.',422);
      throw err;
    }
    if(!p || !['sourceRequestId','sourceReceipt','ticket','receiver','bankTransactionId','receivedDate','evidenceReference'].every(k=>typeof p[k]==='string' && p[k].trim() && p[k].length<=200)) {
      throw transferError_('TRANSFER_REVIEW_INCOMPLETE_NO_EFFECTS','Indica recibo original, cuenta receptora, referencia bancaria, fecha y evidencia.',422);
    }
    const proof={sourceRequestId:p.sourceRequestId,sourceReceipt:p.sourceReceipt,ticket:p.ticket,receiver:p.receiver,
      bankTransactionId:p.bankTransactionId.trim().toUpperCase().replace(/\s+/g,''),receivedDate:p.receivedDate,evidenceReference:p.evidenceReference.trim(),amount:p.amount,currency:p.currency};
    const date=new Date(proof.receivedDate+'T00:00:00Z');
    if(!policy.receivers.includes(proof.receiver) || proof.currency!=='MXN' || !/^[A-Z0-9][A-Z0-9._:/-]{5,127}$/.test(proof.bankTransactionId) ||
        !/^\d{4}-\d{2}-\d{2}$/.test(proof.receivedDate) || !Number.isFinite(date.getTime()) || date.toISOString().slice(0,10)!==proof.receivedDate || proof.receivedDate>new Date().toISOString().slice(0,10) ||
        typeof proof.amount!=='number' || proof.amount<=0 || !Number.isSafeInteger(Math.round(proof.amount*100)) || Math.abs(proof.amount*100-Math.round(proof.amount*100))>0.00001) {
      throw transferError_('TRANSFER_REVIEW_INCOMPLETE_NO_EFFECTS','Revisa cuenta autorizada, importe MXN, fecha y referencia única del banco.',422);
    }
    const index=paymentRequestIndex_(m),source=transferSource_(m,index,proof),confirmed=transferConfirmedRecords_(m,index);
    const bankKey=transferBankKey_(proof.receiver,proof.bankTransactionId),evidenceHash=computePayloadHash_(proof);
    const previous=confirmed.find(r=>r.sourceReceipt===proof.sourceReceipt);
    if(previous) {
      if(previous.evidenceHash!==evidenceHash)throw transferError_('TRANSFER_ALREADY_CONFIRMED','Ese recibo ya tiene otra confirmación; revisar sin repetir cobro.');
      if(previous.journey && p.openingRequestId!==previous.journey.openingRequestId)throw journeyReject_('Transferencia ya confirmada en otra jornada. Recupera su intención original.');
      return previous;
    }
    if(confirmed.some(r=>r.bankKey===bankKey))throw transferError_('TRANSFER_BANK_REFERENCE_USED','Ese movimiento bancario ya fue aplicado.');
    if(proof.amount!==source.total)throw transferError_('TRANSFER_AMOUNT_REQUIRES_REVIEW','Sólo se admite el importe completo del pendiente original; diferencias requieren conciliación.',422);
    const balance=posBalanceFast_({m:m},source.ticket);
    if(!balance.rows.length || balance.due+0.001<proof.amount)throw transferError_('TRANSFER_BALANCE_REQUIRES_REVIEW','La cuenta cambió o ya fue pagada; no aplicar otro cobro.');
    const now=new Date(),journey=journeyForMovement_(m,p,now);
    const originJourney=journey && journeyAccountOrigin_(m,source.ticket,journey,false);
    const receipt='REC-TRF-'+Utilities.getUuid(),verifiedAt=now.toISOString();
    const result={ok:true,kind:'TRANSFER_CONFIRMATION',confirmationRequestId:id,sourceRequestId:proof.sourceRequestId,sourceReceipt:source.receipt,ticket:source.ticket,
      receipt:receipt,total:proof.amount,amountApplied:proof.amount,currency:'MXN',method:'Transferencia',paymentStatus:'CONFIRMADA',paid:true,verified:true,
      verificationMode:'MANUAL_BANK_REVIEW',verifiedBy:_authContext.operator,verifiedRole:_authContext.role,verifiedPrincipal:_authContext.principal,verifiedAt:verifiedAt,
      receiver:proof.receiver,bankTransactionId:proof.bankTransactionId,bankKey:bankKey,receivedDate:proof.receivedDate,evidenceReference:proof.evidenceReference,evidenceHash:evidenceHash,
      customer:source.customer,items:source.items || [],tip:0,received:null,change:null};
    if(journey)Object.assign(result,{journey:journey,originJourney:originJourney});
    const s=transferSheet_(m),row=Math.max(7,s.getLastRow()+1);
    const metadata={version:1,confirmationRequestId:id,sourceRequestId:proof.sourceRequestId,sourceReceipt:source.receipt,bankKey:bankKey};
    const writes=paymentWrites_(s,{row:row,folio:receipt,origin:'Caja',ticket:source.ticket,method:'Transferencia',amount:proof.amount,
      tag:'DOMUS_TRANSFER_CONFIRMATION:'+JSON.stringify(metadata),operator:_authContext.operator,activity:balance.rows[0][3]});
    // Append a new confirmed movement; the original Borrador stays immutable.
    writes.find(w=>w.column===11).value='Confirmado';writes.push(cellWrite_(s,row,10,proof.receiver));
    return journalCommit_(id,'confirmarTransferencia',m,writes,result);
  });
}

// Read-only preparation; approved administrative resolutions use separate actions.
// Bank non-receipt is a human review requirement, never inferred from Borrador.
function prepararResolucionTransferencia(p) {
  authRequireContext_('prepararResolucionTransferencia');
  if(!CONFIG.managers.includes(_authContext.principal))throw transferError_('AUTH_PRINCIPAL_REQUIRED','Renueva la identidad de Gerencia.',401);
  if(!p || !['sourceRequestId','sourceReceipt','ticket'].every(k=>typeof p[k]==='string' && p[k].trim()===p[k] && p[k].length>0 && p[k].length<=200)) {
    throw transferError_('TRANSFER_RESOLUTION_INPUT_REQUIRED','Indica la intención, recibo y cuenta originales.',422);
  }
  return withLock_(CONFIG.lockTimeoutMs,()=>{
    const m=SpreadsheetApp.openById(CONFIG.mainSheetId),context=transferResolutionContext_(m,p),source=context.source,snapshot=context.snapshot;
    const delivered=snapshot.units.filter(u=>u.deliveryEvidence).length;
    const pending=snapshot.units.filter(u=>!['Entregada','Cancelada'].includes(u.state)).length;
    const cancelled=snapshot.units.filter(u=>u.state==='Cancelada').length;
    const decision=delivered?'DELIVERY_OR_CONSUMPTION_REVIEW':snapshot.balance.paid>0?'OTHER_PAYMENT_RECONCILIATION':
      cancelled===snapshot.units.length && snapshot.units.length>0?'CANCELLED_ORDER_RECONCILIATION':'NO_RECORDED_DELIVERY_DECISION';
    return {ok:true,kind:'TRANSFER_RESOLUTION_PROPOSAL',version:1,readOnly:true,executable:false,
      sourceRequestId:p.sourceRequestId,sourceReceipt:source.receipt,ticket:source.ticket,amount:source.total,currency:'MXN',
      bankObservation:'NOT_VERIFIED_BY_SYSTEM',requiresBankReview:true,requiresDeliveryReview:true,decision:decision,
      account:{total:snapshot.balance.total,paid:snapshot.balance.paid,due:snapshot.balance.due},
      fulfillment:{scope:'WHOLE_ACCOUNT',observation:'RECORDED_EVIDENCE_ONLY',total:snapshot.units.length,deliveryEvidence:delivered,pending:pending,cancelled:cancelled,units:snapshot.units},
      sourceJourney:source.journey || null,originJourney:source.originJourney || null,
      // JSON converts native Sheets Dates to ISO strings before canonical hashing.
      snapshotHash:context.snapshotHash,
      observedAt:new Date().toISOString(),preparedBy:_authContext.operator,preparedRole:_authContext.role,preparedPrincipal:_authContext.principal,
      policyRequired:true,canConfirm:false,canCancel:false,canReplacePayment:false,canDeliver:false,canCloseJourney:false,
      policy:{managerCancellationApproved:true,preparedOrdersIncluded:true,paymentSubstitutionApproved:true},
      proposedEffects:{paymentApplied:0,refund:0,inventoryMovement:0,writes:0},
      message:'Propuesta de conciliación. Conserva el pendiente y la deuda; no acredita banco, anula, cobra, entrega ni habilita el cierre.'};
  });
}

function transferResolutionContext_(m,p,ownId) {
  const index=historyOperationalIndex_(m),journal=m.getSheetByName('DOMUS_JOURNAL'),journalRows=journal?dataRows_(journal,2,6):[];
  const own=ownId && index.get(ownId);
  if(own && own.length===1 && ['cancelarTransferenciaNoRecibida','vincularPagoExistente'].includes(own[0][1]) && own[0][4]==='PROCESSING' && !journalFind_(ownId,m))index.delete(ownId);
  if(journalRows.some(r=>r[0] && r[2]!=='COMPLETED'))throw transferError_('TRANSFER_RESOLUTION_REQUIRES_REVIEW','Existe un plan incompleto. Conservar su intención; esta consulta no lo reanuda.');
  index.forEach(rows=>{
    if(rows.length!==1 || (rows[0][4]!=='COMPLETED' && !journeyKnownNoEffects_(m,rows)))throw transferError_('TRANSFER_RESOLUTION_REQUIRES_REVIEW','REQUESTS contiene una intención incierta o duplicada.');
  });
  const source=transferSource_(m,index,p),confirmed=transferConfirmedRecords_(m,index);
  if(confirmed.some(r=>r.sourceRequestId===p.sourceRequestId || r.sourceReceipt===p.sourceReceipt))throw transferError_('TRANSFER_ALREADY_CONFIRMED','Ya existe ingreso acreditado; no cancelar como no recibido.');
  if(transferCancellationRecords_(m,index).some(r=>r.sourceRequestId===p.sourceRequestId))throw transferError_('TRANSFER_ALREADY_CANCELLED','La cancelación ya tiene resolución; recuperar su ID original.');
  if(transferExistingPaymentRecords_(m,index).some(r=>r.sourceRequestId===p.sourceRequestId))throw transferError_('TRANSFER_ALREADY_LINKED','Ya existe un vínculo. Recupera su ID original, sin nuevo cobro.');
  const snapshot=transferResolutionSnapshot_(m,index,source,p.sourceRequestId);
  return {index:index,source:source,snapshot:snapshot,snapshotHash:computePayloadHash_(JSON.parse(JSON.stringify({version:1,book:m.getId(),environment:CONFIG.environment,
    sourceRequestId:p.sourceRequestId,snapshot:snapshot,ledger:Array.from(index.values()),journal:journalRows})))};
}

function transferResolutionSnapshot_(m,index,source,sourceRequestId) {
  const schemas={'CAJA 2':{'Folio línea':1,'CUENTA AUTOMÁTICA':2,'Producto':7,'Cantidad':8,'TOTAL':12,'ACCIÓN DEL PEDIDO':16,'Unidades consumidas':22,'Preparación / entrega':24,'Destino':25},
    COMANDAS:{'Folio línea':1,'Ticket / mesa':2,'PREPARACIÓN / ENTREGA':8,'Registro de sincronización':13}};
  Object.keys(schemas).forEach(name=>{
    const cols=schemaColumns_(m.getSheetByName(name),Object.keys(schemas[name]));
    if(Object.keys(schemas[name]).some(k=>cols[k]!==schemas[name][k]))throw transferError_('TRANSFER_SCHEMA_REQUIRES_REVIEW','Columnas de cuenta o comanda incompatibles.');
  });
  const cash=dataRows_(m.getSheetByName('CAJA 2'),7,32).map((r,i)=>({row:i+7,values:r})).filter(x=>x.values[1]===source.ticket);
  const payments=dataRows_(transferSheet_(m),7,31).filter(r=>r[3]===source.ticket && r[2]==='Caja');
  const records=[],units=[],seen=new Set(),allCommands=[];
  const reject=()=>{throw transferError_('TRANSFER_RESOLUTION_REQUIRES_REVIEW','Cuenta o entrega sin vínculo completo y único. Conservar el historial.');};
  // A formula error or text amount must not become zero through legacy readers.
  const money=n=>typeof n==='number' && Number.isFinite(n) && n>=0;
  if(cash.some(c=>!money(c.values[11])) || payments.some(r=>!money(r[5]) || r[5]===0 || !money(r[13]) || r[13]>r[5]))reject();
  // Inspect the whole account, including deliveries before an empty-items abono.
  index.forEach((_,id)=>{
    const record=paymentRequest_(index,id),r=record && record.result;
    if(record.action==='cajaSimpleRegistrar' && r && r.ticket===source.ticket) {
      const f=r.fulfillment;
      const binding=index.get(id)[0];
      if(record.status!=='COMPLETED' || !/^[a-f0-9]{64}$/.test(String(binding[2])) || !binding[3] || r.ok!==true || !f || f.version!==1 || f.sourceRequestId!==id || !Array.isArray(f.units))reject();
      records.push(record);
      f.units.forEach(u=>{
        if(!u || typeof u.id!=='string' || !u.id || !Number.isInteger(u.row) || u.row<7 || typeof u.qty!=='number' || !Number.isFinite(u.qty) || u.qty<=0 ||
          !['sku','product','destination'].every(k=>typeof u[k]==='string' && u[k]) || seen.has(u.id))reject();
        seen.add(u.id);units.push({unit:u,batch:id});
      });
    }
  });
  if(!records.some(r=>r.id===sourceRequestId) || !units.length || cash.length!==units.length)reject();
  dataRows_(m.getSheetByName('COMANDAS'),7,14).forEach((r,i)=>{
    if(!r[12]){if(seen.has(r[0]) || r[1]===source.ticket)reject();return;}
    let item;try{item=JSON.parse(r[12]);}catch(_){reject();}
