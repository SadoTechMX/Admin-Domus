        item.delivered || item.deliveredBy || c[0][7]!=='Cancelada' || a.length!==1 || a[0][1]!==p.ticket || a[0][15]!=='Cancelado' || Number(a[0][21])>0 || a[0][23]==='Entregada')fail();
    });
