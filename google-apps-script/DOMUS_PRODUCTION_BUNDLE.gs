  if(!p || !['sourceRequestId','sourceReceipt','ticket'].every(k=>typeof p[k]==='string' && p[k].trim()===p[k] && p[k] && p[k].length<=200))throw existingPaymentError_('Indica pendiente, recibo y cuenta originales.');
