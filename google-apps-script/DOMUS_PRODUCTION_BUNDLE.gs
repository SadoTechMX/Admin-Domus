function cashFormulaWrites_(sheet, row) {
  return Object.keys(CASH_FORMULAS_).map(c => {
    const formula = CASH_FORMULAS_[c].replace(/(\$?[A-Z]{1,3})(\$?)(25)(?![0-9])/g,
