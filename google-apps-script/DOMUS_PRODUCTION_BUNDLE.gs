// --- FUNCIONES MATEMÁTICAS PURAS Y HELPERS ---

function posRound_(n) {
  return Math.round((Number(n) + Number.EPSILON) * 100) / 100;
}

function posSignature_(value) {
  const canonical = v => Array.isArray(v) ? v.map(canonical) : (v && typeof v === 'object' ? Object.keys(v).sort().reduce((r, k) => { r[k] = canonical(v[k]); return r; }, {}) : v);
  return JSON.stringify(canonical(value));
}

function posCatalogRows_(cat) {
  const rows = new Map();
  for (const r of cat) {
    if (r[0] && r[8] === 'Sí' && (r[15] ? r[18] === 'Sí' : r[1] === 'Cannábicos')) {
      rows.set(String(r[1]) + '|' + String(r[15] || r[0]), r);
    }
  }
  return Array.from(rows.values());
}

function posPaymentMath_(due, method, received, tip) {
  due = posRound_(due);
  if (!Number.isFinite(due) || due < 0) throw new Error('Saldo inválido.');
  if (!['Efectivo', 'Terminal 1', 'Terminal 2', 'Transferencia'].includes(method)) {
    throw new Error('Elige un medio de pago válido.');
  }
  if (method !== 'Efectivo') {
    return { sale: due, received: null, tip: 0, change: null };
  }
  if (received === '' || received === null || received === undefined || !Number.isFinite(Number(received))) {
    throw new Error('Escribe el efectivo recibido.');
  }
  received = posRound_(received);
  tip = posRound_(tip || 0);
  if (!Number.isFinite(tip) || tip < 0 || received < 0) {
    throw new Error('Revisa el efectivo recibido y la propina.');
  }
  if (received + 0.001 < due + tip) {
    throw new Error('Efectivo insuficiente: faltan $' + posRound_(due + tip - received).toFixed(2) + '.');
  }
  return { sale: due, received: received, tip: tip, change: posRound_(received - due - tip) };
}

function posExpandCart_(items, cat, phase, canCourtesy, eventPrices) {
  if (!Array.isArray(items) || !items.length) throw new Error('Pedido vacío o inválido.');
  const units = [];
  const catalogRows = posCatalogRows_(cat);

  for (const item of items) {
    if (!item || typeof item !== 'object') throw new Error('Producto inválido.');
    const matches = catalogRows.filter(r => item.sku ? String(r[6]) === String(item.sku) : r[0] === item.name);
    if (matches.length !== 1) throw new Error('PRODUCT_NOT_FOUND: referencia inexistente, inactiva o ambigua.');
    const c = matches[0];
    const rawPrice = c[15] ? c[phase === 'Solar' ? 16 : 17] : c[2];
    const basePrice = Number(rawPrice);
    const special = eventPrices && eventPrices.get(String(c[6] || ''));
    if (special && Math.abs(basePrice - special.base) > 0.01) throw new Error('EVENT_BASE_PRICE_MISMATCH: ' + String(c[6] || ''));
    const price = special ? special.price : basePrice;
    const qty = Number(item.qty);
    if (rawPrice === '' || rawPrice == null || !Number.isFinite(basePrice) || basePrice < 0 || !Number.isFinite(price) || price < basePrice) throw new Error('Precio de catálogo/evento inválido.');
    if (!Number.isInteger(qty) || qty < 1 || qty > 20) throw new Error('Cantidad debe ser entera entre 1 y 20.');
    if (item.courtesy && !canCourtesy) throw new Error('Acceso denegado: cortesía requiere Gerencia.');

    for (let j = 0; j < qty; j++) {
      units.push({
        name: c[0],
        group: c[1] || 'General',
        price: price,
        basePrice: basePrice,
        eventExtra: special ? special.extra : 0,
        extraBeneficiary: special ? special.beneficiary : '',
        courtesy: !!item.courtesy,
        share: c[3] || 0,
        beneficiary: c[4] || 'DOMUS',
        inventory: c[6] || '',
        sku: c[6] || '',
        notes: String(item.notes || '').slice(0, 500),
        destination: c[7] || (c[1] === 'Alimentos' ? 'Cocina' : 'Barra')
      });
    }
  }
  if (units.length > 50) throw new Error('Máximo 50 unidades por operación.');
  return units;
}


// MODULE Access
/**
 * ============================================================================
 * DOMUS OS · ADMISSIONS, TICKETING & WARDROBE SYSTEM (Access.gs)
 * Fase 0.5: Modelo Comercial Integral de Accesos, Taquilla, Boleteras y Aforo (ADR-005)
 * ============================================================================
 */

'use strict';

/**
 * Canales de Venta de Boletos
 */
const ACCESS_SALES_CHANNELS = Object.freeze({
  TAQUILLA_DOMUS: 'TAQUILLA_DOMUS',
  PREVENTA_DOMUS: 'PREVENTA_DOMUS',
  BOLETERA_EXTERNA: 'BOLETERA_EXTERNA',
  TRANSFERENCIA_DIRECTA: 'TRANSFERENCIA_DIRECTA',
  LISTA: 'LISTA',
  CORTESIA: 'CORTESIA',
  MEMBRESIA: 'MEMBRESIA'
});

/**
 * Estados de Pago de la Entrada
 */
const ACCESS_PAYMENT_STATUS = Object.freeze({
  CONFIRMADA: 'CONFIRMADA',
  PAGADO_EXTERNAMENTE: 'PAGADO_EXTERNAMENTE',
  PENDIENTE_VERIFICACION: 'PENDIENTE_VERIFICACION',
  RECHAZADA: 'RECHAZADA'
});

/**
 * Consulta de eventos activos y registros de acceso en vivo
 */
function accesoSimpleDatos() {
  authRequireContext_('accesoSimpleDatos');
  const m = SpreadsheetApp.openById(CONFIG.mainSheetId);
  const sAct = m.getSheetByName('ACTIVIDADES');
  const sAcc = m.getSheetByName('ACCESO');
  const props = PropertiesService.getScriptProperties();

  // 1. Obtener actividades / eventos y sus tipos de boletos
  const rawActs = sAct ? dataRows_(sAct, 7, 13) : [];
  const activities = [];
  rawActs.forEach(r => {
    if (r[0]) {
      const pGen = typeof r[4] === 'number' ? r[4] : (parseFloat(r[4]) || 0);
      const pPar = typeof r[5] === 'number' ? r[5] : (parseFloat(r[5]) || 0);
      const pTrio = typeof r[6] === 'number' ? r[6] : (parseFloat(r[6]) || 0);
      let pGua = 50;
      if (typeof r[7] === 'number') {
        pGua = r[7];
      } else if (r[7] !== '' && r[7] !== null && r[7] !== undefined) {
        const parsed = parseFloat(r[7]);
        pGua = isNaN(parsed) ? 50 : parsed;
      }

      // Tipos de boletos del evento (estándar + personalizados en notas col M)
      let customTicketTypes = [];
      try {
        if (r[12] && String(r[12]).trim().startsWith('[')) {
          customTicketTypes = JSON.parse(r[12]);
        }
      } catch (e) {}

      const ticketTypes = [
        { id: 'General', name: 'General (1 Asistente)', price: pGen, persons: 1 },
        { id: 'Pareja', name: 'Pareja (2 Asistentes)', price: pPar, persons: 2 },
        { id: 'Trío', name: 'Trío (3 Asistentes)', price: pTrio, persons: 3 },
        ...customTicketTypes
      ];

      activities.push({
        name: String(r[0]),
        date: r[1] instanceof Date ? Utilities.formatDate(r[1], 'America/Mexico_City', 'yyyy-MM-dd') : String(r[1] || ''),
        type: String(r[2] || 'CLUB_NOCTURNO'),
        organizer: String(r[3] || 'DOMUS'),
        priceGeneral: pGen,
        pricePareja: pPar,
        priceTrio: pTrio,
        priceGuardarropa: pGua,
        capacity: Number(r[8]) || 150,
        status: String(r[11] || 'Confirmado'),
        ticketTypes: ticketTypes
      });
    }
  });

  // Actividad activa configurada
  const settings=m.getSheetByName('DOMUS_SETTINGS');
  let activeActivity = (settings && settings.getRange(1,2).getValue()) || props.getProperty('actividadAcceso') || '';
  if (!activeActivity && activities.length > 0) {
    activeActivity = activities[0].name;
  }

  // 2. Obtener accesos registrados con modelo comercial integral (22 campos)
  const rawAcc = sAcc ? dataRows_(sAcc, 7, 32) : [];
  const recentAccess = [];
  let totalAttendance = 0;
  let activeWardrobe = 0;
  let totalDoorRevenue = 0;
  let totalCommercialGross = 0;
  let presalesCount = 0;
  let courtesiesCount = 0;

  rawAcc.forEach((r, idx) => {
    if (r[0] && r[3] && r[1] && r[28] !== false) {
      const rowId = String(r[0] || ('A-' + String(idx + 7).padStart(4, '0')));
      const dateStr = r[1] instanceof Date ? Utilities.formatDate(r[1], 'America/Mexico_City', 'yyyy-MM-dd HH:mm') : String(r[1] || '');
      const activity = String(r[2] || activeActivity);
      const customer = String(r[3] || 'Anónimo');
      const email = String(r[4] || '');
      const phone = String(r[5] || '');
      const ticketTypeId = String(r[6] || 'General');
      const persons = Number(r[7]) || (ticketTypeId === 'Pareja' ? 2 : (ticketTypeId === 'Trío' ? 3 : 1));
      const wardrobeQty = Number(r[8]) || 0;
      const faceValue = Number(r[9]) || 0;
      const wardrobeAmount = Number(r[12]) || 0;
      const totalCommercial = Number(r[13]) || (faceValue + wardrobeAmount);
      const amountPaidAtDoor = Number(r[14]) || 0;
      const amountDueAtDoor = Number(r[15]) || 0;
      const paymentStatus = String(r[16] || 'CONFIRMADA');
      const externalTicketId = String(r[17] || '');
      const courtesyAuth = String(r[18] || '');
      let metadata={}; try { metadata=JSON.parse(r[29]); } catch(e) {}
      const salesChannel = metadata.salesChannel || (typeof r[19]==='string' && ACCESS_SALES_CHANNELS[r[19]] ? r[19] : (externalTicketId?'BOLETERA_EXTERNA':'TAQUILLA_DOMUS'));
      const ticketProvider = String(r[20] || 'DOMUS');
      const method = String(r[26] || 'Efectivo');
      const ticketGuardarropa = String(r[30] || (wardrobeQty > 0 ? ('GUA-' + rowId) : ''));
      const wardrobeReturned = String(r[31] || '').toUpperCase().includes('DEVUELTO') || r[31] === true;

      totalAttendance += persons;
      totalDoorRevenue += amountPaidAtDoor;
      totalCommercialGross += totalCommercial;
      if (salesChannel === 'BOLETERA_EXTERNA' || salesChannel === 'PREVENTA_DOMUS') presalesCount++;
      if (salesChannel === 'CORTESIA') courtesiesCount++;
      if (wardrobeQty > 0 && !wardrobeReturned) {
        activeWardrobe += wardrobeQty;
      }

      recentAccess.unshift({
        id: rowId,
        date: dateStr,
        activity: activity,
        customer: customer,
        email: email,
        phone: phone,
        ticketTypeId: ticketTypeId,
        persons: persons,
        salesChannel: salesChannel,
        ticketProvider: ticketProvider,
        externalTicketId: externalTicketId,
        faceValue: faceValue,
        wardrobeQty: wardrobeQty,
        wardrobeAmount: wardrobeAmount,
        totalCommercial: totalCommercial,
        amountPaidAtDoor: amountPaidAtDoor,
        amountDueAtDoor: amountDueAtDoor,
        paymentStatus: paymentStatus,
        paymentMethod: method,
        courtesyAuth: courtesyAuth,
        ticketGuardarropa: ticketGuardarropa,
        wardrobeReturned: wardrobeReturned
      });
    }
  });

  return {
    activeActivity: activeActivity,
    activities: activities,
    recentAccess: recentAccess,
    metrics: {
      totalAttendance: totalAttendance,
      attendanceKind: 'CUMULATIVE_ADMISSIONS_NOT_OCCUPANCY',
      activeWardrobe: activeWardrobe,
      totalDoorRevenue: totalDoorRevenue,
      totalCommercialGross: totalCommercialGross,
      presalesCount: presalesCount,
      courtesiesCount: courtesiesCount
    }
  };
}

/**
 * Registra un acceso/asistencia y su cobro en ACCESO y COBROS bajo candado estricto
 * Fase 0.5: Atribución correcta de ingresos (Boleteras vs Taquilla vs Guardarropa)
 */
function accesoSimpleRegistrar(payload) {
  authRequireContext_('accesoSimpleRegistrar');
  if (!payload) throw new Error('Datos de acceso requeridos.');
  return withLock_(CONFIG.lockTimeoutMs, () => {
    const m=SpreadsheetApp.openById(CONFIG.mainSheetId), s=m.getSheetByName('ACCESO'), cob=m.getSheetByName('COBROS');
    const req=String(payload.requestId || payload.id || '');
    const replay=journalResume_(req,'accesoSimpleRegistrar',m); if(replay)return replay;
    schemaColumns_(s,['Folio acceso','2 · NOMBRE','ORDEN PREVENTA','DESGLOSE / ESTADO','TICKET / PRENDA']);
    const customer=String(payload.customer || '').trim(), activity=String(payload.activity || '').trim();
    if(!customer || !activity)throw new Error('Nombre y actividad obligatorios.');
    const event=dataRows_(m.getSheetByName('ACTIVIDADES'),7,13).find(r=>String(r[0])===activity);
    if(!event || String(event[11]).toLowerCase()!=='confirmado')throw new Error('EVENT_PRICING_NOT_CONFIRMED');
    const channel=String(payload.salesChannel || 'TAQUILLA_DOMUS');
    if(!Object.values(ACCESS_SALES_CHANNELS).includes(channel))throw new Error('Canal inválido.');
    const type=String(payload.ticketTypeId || payload.entryType || 'General');
    let kinds=[{id:'General',price:event[4],persons:1},{id:'Pareja',price:event[5],persons:2},{id:'Trío',price:event[6],persons:3}];
    if(event[12] && String(event[12]).trim()[0]==='[') kinds=kinds.concat(JSON.parse(event[12]));
    const kind=kinds.find(k=>k.id===type || k.name===type);
    const onlyWardrobe=['SOLO_GUARDARROPA','GUARDARROPA'].includes(type);
    if(!kind && !onlyWardrobe)throw new Error('Tipo de entrada inválido.');
    const persons=onlyWardrobe?0:Number(kind.persons);
    if(!Number.isInteger(persons) || persons<0 || persons>100)throw new Error('Personas inválidas.');
    const qty=payload.wardrobeQty==null?0:Number(payload.wardrobeQty);
    if(!Number.isInteger(qty)||qty<0||qty>100)throw new Error('Prendas inválidas.');
    const unitPrice=Number(event[7]);
    if(!Number.isFinite(unitPrice)||unitPrice<0)throw new Error('Tarifa de guardarropa no confirmada.');
    let face=onlyWardrobe?0:Number(kind.price);
    if(!Number.isFinite(face)||face<0)throw new Error('Tarifa inválida.');
    if(channel==='CORTESIA') {
      if(!['ADMIN','GERENCIA'].includes(_authContext.role))throw new Error('Acceso denegado: cortesía requiere Gerencia.');
      face=0;
    }
    const qr=String(payload.externalTicketId || payload.presaleFolio || '').trim();
    if(['PREVENTA_DOMUS','BOLETERA_EXTERNA'].includes(channel) && !qr)throw new Error('Folio de boleto obligatorio.');
    const existing=dataRows_(s,7,32);
    if(qr && existing.some(r=>r[2]===activity && String(r[17]).trim()===qr && r[3]))throw new Error('Boleto ya utilizado.');
    const method=String(payload.paymentMethod || payload.method || 'Efectivo');
    if(!['Efectivo','Terminal 1','Terminal 2','Transferencia'].includes(method))throw new Error('Medio inválido.');
    // Do not accept isTransferVerified/paymentStatus from the browser as bank verification.
    const pending=method==='Transferencia' || channel==='TRANSFERENCIA_DIRECTA';
    const doorEntry=['TAQUILLA_DOMUS','TRANSFERENCIA_DIRECTA'].includes(channel)?face:0;
    const wardrobe=qty*unitPrice, charged=doorEntry+wardrobe;
    const row=Math.max(7,s.getLastRow()+1), id='A-'+Utilities.getUuid(), gua=qty?'GUA-'+id:'';
    const status=pending?'PENDIENTE_VERIFICACION':(channel==='BOLETERA_EXTERNA'?'PAGADO_EXTERNAMENTE':'CONFIRMADA');
    const result={ok:true,id:id,rowId:id,ticket:id,customer:customer,activity:activity,ticketTypeId:type,
      persons:persons,salesChannel:channel,externalTicketId:qr,faceValue:face,wardrobeQty:qty,
      wardrobeAmount:wardrobe,ticketGuardarropa:gua,paymentStatus:status,paymentMethod:method,
      doorCollected:pending?0:charged,amountPaidAtDoor:pending?0:charged,amountDueAtDoor:pending?charged:0,
      totalCommercial:face+wardrobe,date:new Date().toISOString(),message:pending?'Transferencia pendiente de verificación.':'Acceso registrado.'};
    const fields={1:id,2:new Date(),3:activity,4:customer,5:String(payload.email||''),6:String(payload.phone||''),
      7:type,8:persons,9:qty,10:face,11:'',12:face,13:wardrobe,14:face+wardrobe,15:pending?0:charged,
      16:pending?charged:0,17:status,18:qr,19:channel==='CORTESIA'?_authContext.operator:'',
      23:'Registrado',26:persons,27:method,28:pending?0:charged,29:true,30:JSON.stringify(result),31:gua,32:false};
    const writes=Object.keys(fields).map(c=>cellWrite_(s,row,Number(c),fields[c]));
    let next=Math.max(cob.getLastRow()+1,7);
    if(doorEntry>0)writes.push(...paymentWrites_(cob,{row:next++,folio:'REC-TAQ-'+Utilities.getUuid(),origin:'Acceso',ticket:id,method:pending?'Transferencia':method,amount:doorEntry,tag:'ACCESO-WEB:'+req,operator:_authContext.operator,activity:activity}));
    if(wardrobe>0)writes.push(...paymentWrites_(cob,{row:next++,folio:'REC-GUA-'+Utilities.getUuid(),origin:'Acceso',ticket:id,method:pending?'Transferencia':method,amount:wardrobe,tag:'ACCESO-GUA:'+req,operator:_authContext.operator,activity:activity}));
    return journalCommit_(req,'accesoSimpleRegistrar',m,writes,result);
  });
}

/**
 * Devuelve una prenda de guardarropa
 */
function guardarropaDevolver(payload) {
  authRequireContext_('guardarropaDevolver');
  if (!payload || !payload.ticket) throw new Error('Ticket de guardarropa requerido.');
  const ticket = String(payload.ticket).trim();

  return withLock_(CONFIG.lockTimeoutMs, () => {
    const m = SpreadsheetApp.openById(CONFIG.mainSheetId);
    const sAcc = m.getSheetByName('ACCESO');
    if (!sAcc) throw new Error('Hoja ACCESO no encontrada.');

    const lastRow = Math.max(sAcc.getLastRow(), 7);
    const rows = sAcc.getRange(7, 1, lastRow - 6, 32).getValues();
    let foundRow = -1;
    let alreadyReturned = false;

    for (let i = 0; i < rows.length; i++) {
      const rowTicketGuardarropa = String(rows[i][30]).trim();
      const rowAccessId = String(rows[i][0]).trim();
      if (rowTicketGuardarropa === ticket || rowAccessId === ticket) {
        foundRow = i + 7;
        const valCol32 = rows[i][31];
        if (valCol32 === true || String(valCol32).toUpperCase().includes('DEVUELTO') || String(rows[i][28]).toUpperCase().includes('DEVUELTO')) {
          alreadyReturned = true;
        }
        break;
      }
    }

    if (foundRow === -1) {
      throw new Error(`Ticket de guardarropa "${ticket}" no encontrado.`);
    }

    if (alreadyReturned) {
      throw new Error(`Prenda del ticket "${ticket}" ya fue devuelta previamente.`);
    }

    return journalCommit_(payload.requestId,'guardarropaDevolver',m,[cellWrite_(sAcc,foundRow,32,true)],{ok:true,ticket:ticket,message:'Prendas devueltas.'});
  });
}

/**
 * Cambia la actividad / evento activo en el sistema
 */
function accesoCambiarActividad(payload) {
  authRequireContext_('accesoCambiarActividad');
  const m=SpreadsheetApp.openById(CONFIG.mainSheetId),act=String(payload && payload.activity || '');
  if(!dataRows_(m.getSheetByName('ACTIVIDADES'),7,13).some(r=>String(r[0])===act && String(r[11]).toLowerCase()==='confirmado'))throw new Error('Actividad no confirmada.');
  let settings=m.getSheetByName('DOMUS_SETTINGS');if(!settings)settings=m.insertSheet('DOMUS_SETTINGS');
  return journalCommit_(payload.requestId,'accesoCambiarActividad',m,[cellWrite_(settings,1,1,'ACTIVE_ACTIVITY'),cellWrite_(settings,1,2,act)],{ok:true,activeActivity:act});
}


// MODULE KDS
/**
 * ============================================================================
 * DOMUS OS · KITCHEN & BAR DISPLAY SYSTEM (KDS.gs)
 * Gestión de comandas en tiempo real, lotes de preparación y resurtido
 * ============================================================================
 */

'use strict';

/**
 * Consulta de comandas activas, historial reciente y solicitudes de resurtido
 */
function comandasSimpleDatos(token) {
  authRequireContext_('comandasSimpleDatos');
  const m = SpreadsheetApp.openById(CONFIG.mainSheetId);
  const o = SpreadsheetApp.openById(CONFIG.opsSheetId);
  const sComandas = m.getSheetByName('COMANDAS');
  const oResurtido = o ? o.getSheetByName('RESURTIDO') : null;

  // 1. Leer comandas activas + historial desde la columna M (JSON maestro).
  // La columna M es la fuente de verdad del KDS; H/N se mantienen como espejo humano.
  const masterRaw = dataRows_(sComandas, 7, 1, 13);
  const orders = [];
  const history = [];
  const now = Date.now();

  const toClientItem = item => ({
    key: 'DCS-' + item.row + '-' + (item.batch || item.id),
    version: String(item.version || '1'),
    id: item.id || ('C2-' + item.row),
    ticket: item.ticket || '',
    batch: item.batch || item.id,
    alias: item.alias || 'Cliente',
    product: item.product || '',
    notes: item.notes || '',
    destination: item.destination || 'Barra',
    state: item.state || 'Pendiente',
    responsible: item.responsible || item.preparedBy || '',
    sent: item.sent ? new Date(item.sent).getTime() : now,
    claimed: item.claimed ? new Date(item.claimed).getTime() : null,
    ready: item.ready ? new Date(item.ready).getTime() : null,
    delivered: item.delivered ? new Date(item.delivered).getTime() : null,
    deliveredBy: item.deliveredBy || '',
    cancelled: item.cancelled ? new Date(item.cancelled).getTime() : null,
    credit: !!item.credit,
    incident: item.incident || ''
  });

  masterRaw.forEach(row => {
    if (!row[0]) return;
    try {
      const item = JSON.parse(row[0]);
      if (!item) return;
      const clientItem = toClientItem(item);
      if (clientItem.state === 'Entregada') {
        history.push(clientItem);
      } else if (clientItem.state !== 'Cancelada') {
        orders.push(clientItem);
      }
    } catch (err) {
      console.warn('[KDS] JSON inválido en COMANDAS!M:', err);
    }
  });

  // Activas: las más antiguas primero. Historial: entrega/cancelación más reciente primero.
  orders.sort((a, b) => (a.sent || 0) - (b.sent || 0));
  history.sort((a, b) =>
    (b.delivered || b.cancelled || b.sent || 0) -
    (a.delivered || a.cancelled || a.sent || 0)
  );

  // 2. Leer resurtidos abiertos
  const requests = [];
  if (oResurtido) {
    const resRows = dataRows_(oResurtido, 7, 8);
    resRows.forEach(r => {
      if (r[0] && r[5] !== true && r[7] !== 'Resuelto') {
        requests.push({
          id: String(r[0]),
          product: String(r[2]),
          type: String(r[3] || 'Reposición'),
          created: r[1] instanceof Date ? r[1].getTime() : Date.now()
        });
      }
    });
  }

  return {
    version: 'Comandas Simple 2.1',
    at: Date.now(),
    mirrorSync: 'Conectado a Google Sheets',
    team: CONFIG.staff,
    orders: orders,
    history: history.slice(0, 100),
    requests: requests,
    issues: []
  };
}

/**
 * Aplica una acción sobre una comanda (TOMAR, LISTA, ENTREGAR, ALMACEN, AGOTADO)
 */
function comandasSimpleAccion(tokenOrBody, maybeBody) {
  authRequireContext_('comandasSimpleAccion');
  const body=maybeBody && typeof maybeBody==='object'?maybeBody:tokenOrBody;
  if(!body || typeof body!=='object' || !body.key || !body.action)throw new Error('Parámetros inválidos de comanda.');
  return withLock_(CONFIG.lockTimeoutMs,()=>{
    const m=SpreadsheetApp.openById(CONFIG.mainSheetId), s=m.getSheetByName('COMANDAS');
    const req=String(body.requestId || body.id || '');
    const resumed=journalResume_(req,'comandasSimpleAccion',m);if(resumed)return resumed;
    const rows=dataRows_(s,7,1,13);
    const entries=[];
    rows.forEach((r,i)=>{if(r[0]){let it;try{it=JSON.parse(r[0]);}catch(e){return;} entries.push({row:i+7,item:it});}});
    const target=entries.find(e=>'DCS-'+e.item.row+'-'+(e.item.batch||e.item.id)===body.key);
    if(!target)throw new Error('Comanda no encontrada.');
    const item=target.item, action=String(body.action).toUpperCase(), who=_authContext.operator;
    if(_authContext.role==='COCINA' && item.destination!=='Cocina')throw new Error('Acceso denegado a otra estación.');
    if(_authContext.role==='BARRA' && item.destination!=='Barra')throw new Error('Acceso denegado a otra estación.');
    const writes=[];let state=item.state;let selected=[target];
    if(action==='TOMAR') {
      if(state==='En preparación')return {ok:true,state:state,responsible:item.responsible};
      if(state!=='Pendiente')throw new Error('INVALID_KDS_TRANSITION: TOMAR requiere estado Pendiente; actual: '+state);
      selected=entries.filter(e=>e.item.batch===item.batch && e.item.destination===item.destination && e.item.state==='Pendiente');
      state='En preparación';
    } else if(action==='LISTA') {
      if(state==='Lista')return {ok:true,state:state};
      if(state!=='En preparación')throw new Error('INVALID_KDS_TRANSITION: LISTA requiere estado En preparación; actual: '+state);state='Lista';
    } else if(action==='ENTREGAR') {
      if(state==='Entregada')return {ok:true,state:state};
      if(state!=='Lista')throw new Error('INVALID_KDS_TRANSITION: ENTREGAR requiere estado Lista; actual: '+state);
      writes.push(...deliveryInventoryWrites_(m,item)); state='Entregada';
    } else if(action==='CANCELAR') {
      if(['Entregada','Cancelada'].includes(state))throw new Error('INVALID_KDS_TRANSITION');
      state='Cancelada'; writes.push(cellWrite_(m.getSheetByName('CAJA 2'),target.row,16,'Cancelado'));
    } else if(['ALMACEN','AGOTADO'].includes(action)) {
      const o=SpreadsheetApp.openById(CONFIG.opsSheetId),res=o.getSheetByName('RESURTIDO');
      if(!res)throw new Error('Hoja RESURTIDO no encontrada.');
      item.incident=action==='ALMACEN'?'Reponer de almacén':'Agotado en DOMUS';
      const r=Math.max(res.getLastRow()+1,7),values=['RS-'+Utilities.getUuid(),new Date(),item.product,item.incident,1,false,'','Resurtido pendiente'];
      values.forEach((v,i)=>writes.push(cellWrite_(res,r,i+1,v)));
    } else throw new Error('Acción KDS no soportada.');
    selected.forEach(e=>{
      const it=e.item;it.state=state;it.version=String(Number(it.version||1)+1);
      if(action==='TOMAR'){it.responsible=who;it.claimed=new Date().toISOString();}
      if(action==='LISTA')it.ready=new Date().toISOString();
      if(action==='ENTREGAR'){it.delivered=new Date().toISOString();it.deliveredBy=who;}
      if(action==='CANCELAR')it.cancelled=new Date().toISOString();
      writes.push(cellWrite_(s,e.row,13,JSON.stringify(it)),cellWrite_(s,e.row,8,state==='En preparación'?'Preparando':state));
      writes.push(cellWrite_(s,e.row,14,state+' · '+who));
    });
    return journalCommit_(req,'comandasSimpleAccion',m,writes,{ok:true,key:body.key,state:state,product:item.product,responsible:who,message:'Comanda '+state});
  });
}

function deliveryInventoryWrites_(m,item) {
  const inv=m.getSheetByName('INVENTARIO');
  schemaColumns_(inv,['Producto / variante','INICIAL REAL','Entregado por comandas','Existencia esperada']);
  const cat=dataRows_(m.getSheetByName('CATALOGO'),7,20).find(r=>r[0]===item.product);
  if(!cat)throw new Error('PRODUCT_NOT_FOUND');
  const recipes=m.getSheetByName('RECETAS CARTA');
  const matches=recipes?dataRows_(recipes,2,10).map((r,i)=>({r:r,row:i+2})).filter(e=>String(e.r[0])===String(cat[15])):[];
  const writes=[];
  if(matches.length) {
    const stock=m.getSheetByName('INSUMOS');
    schemaColumns_(stock,['Grupo stock','Unidad control','Receta entregada','Existencia teórica']);
    const ingredients=dataRows_(stock,7,12), totals={};
    matches.forEach(e=>{
      const amount=Number(e.r[5])*Number(e.r[7])*Number(item.qty||1), group=String(e.r[6]);
      if(!group||!Number.isFinite(amount)||amount<=0)throw new Error('RECIPE_INVALID');
      totals[group]=(totals[group]||0)+amount;
      const name=String(item.product).replace(/"/g,'""');
      writes.push(cellWrite_(recipes,e.row,10,`=SUMIF('CAJA 2'!$G$7:$G,"${name}",'CAJA 2'!$V$7:$V)*F${e.row}*H${e.row}`,true));
    });
    Object.keys(totals).forEach(group=>{
      const found=ingredients.map((r,i)=>({r:r,row:i+7})).filter(e=>String(e.r[0])===group);
      if(found.length!==1)throw new Error('INGREDIENT_NOT_FOUND: '+group);
      const e=found[0];
      if(e.r[3]==='' || !Number.isFinite(Number(e.r[7])))throw new Error('STOCK_COUNT_REQUIRED: '+group);
      if(Number(e.r[7])+0.000001<totals[group])throw new Error('INSUFFICIENT_STOCK: '+group);
      writes.push(cellWrite_(stock,e.row,7,`=SUMIF('RECETAS CARTA'!$G$2:$G,A${e.row},'RECETAS CARTA'!$J$2:$J)`,true));
    });
  } else {
    const candidates=dataRows_(inv,7,16).map((r,i)=>({r:r,row:i+7})).filter(e=>String(e.r[0])===item.product || String(e.r[0]).endsWith(' · '+String(cat[6])));
    if(candidates.length!==1)throw new Error('INVENTORY_ITEM_NOT_FOUND');
    const e=candidates[0];
    if(e.r[3]==='' || !Number.isFinite(Number(e.r[7])))throw new Error('STOCK_COUNT_REQUIRED');
    if(Number(e.r[7])<Number(item.qty||1))throw new Error('INSUFFICIENT_STOCK');
    if(!inv.getRange(e.row,7).getFormula() || !inv.getRange(e.row,8).getFormula())throw new Error('INVENTORY_FORMULA_REQUIRED');
  }
  // CAJA 2 V/X and INVENTARIO G/H are calculated. Preserve them; COMANDAS A/H supplies delivery.
  return writes;
}

/**
 * Resuelve una incidencia de resurtido
 */
function comandasSimpleResolver(tokenOrBody, maybeBody) {
  authRequireContext_('comandasSimpleResolver');
  const body = (maybeBody && typeof maybeBody === 'object') ? maybeBody : tokenOrBody;
  if (!body || !body.id) throw new Error('ID de solicitud de resurtido no especificado.');

  return withLock_(CONFIG.lockTimeoutMs, () => {
    const o = SpreadsheetApp.openById(CONFIG.opsSheetId);
    if (!o) throw new Error('Libro operativo no encontrado.');
    const sRes = o.getSheetByName('RESURTIDO');
    if (!sRes) throw new Error('Hoja RESURTIDO no encontrada.');

    const values = dataRows_(sRes, 7, 8);
    for (let i = 0; i < values.length; i++) {
      if (String(values[i][0]).trim().toUpperCase() === String(body.id).trim().toUpperCase()) {
        const row = i + 7;
        const m=SpreadsheetApp.openById(CONFIG.mainSheetId);
        return journalCommit_(body.requestId,'comandasSimpleResolver',m,[cellWrite_(sRes,row,6,true),cellWrite_(sRes,row,7,new Date()),cellWrite_(sRes,row,8,'Resuelto')],{ok:true,message:'Disponibilidad confirmada para '+body.id});
      }
    }

    throw new Error('Solicitud ' + body.id + ' no encontrada.');
  });
}

