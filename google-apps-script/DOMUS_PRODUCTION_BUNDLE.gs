// --- FUNCIONES MATEMÁTICAS PURAS Y HELPERS ---

function posRound_(n) {
  return Math.round((Number(n) + Number.EPSILON) * 100) / 100;
}

function posSignature_(value) {
  const canonical = v => Array.isArray(v) ? v.map(canonical) : (v && typeof v === 'object' ? Object.keys(v).sort().reduce((r, k) => { r[k] = canonical(v[k]); return r; }, {}) : v);
  return JSON.stringify(canonical(value));
}

function posCatalogRows_(cat) {
  const rows = new Map();
  for (const r of cat) {
    if (r[0] && r[8] === 'Sí' && (r[15] ? r[18] === 'Sí' : r[1] === 'Cannábicos')) {
      rows.set(String(r[1]) + '|' + String(r[15] || r[0]), r);
    }
  }
  return Array.from(rows.values());
}

// Use only at explicit validation checks before journal preparation/business writes.
// Never wrap journalResume_, journalCommit_, Sheets failures or unknown exceptions.
function posValidationError_(message) {
  const err = new Error(message);
  err.code = 'SALE_VALIDATION_REJECTED_NO_EFFECTS'; err.status = 422;
  return err;
}

function posPaymentMath_(due, method, received, tip) {
  due = posRound_(due);
  if (!Number.isFinite(due) || due < 0) throw posValidationError_('Saldo inválido.');
  if (!['Efectivo', 'Terminal 1', 'Terminal 2', 'Transferencia'].includes(method)) {
    throw posValidationError_('Elige un medio de pago válido.');
  }
  if (method !== 'Efectivo') {
    return { sale: due, received: null, tip: 0, change: null };
  }
  if (received === '' || received === null || received === undefined || !Number.isFinite(Number(received))) {
    throw posValidationError_('Escribe el efectivo recibido.');
  }
  received = posRound_(received);
  tip = posRound_(tip || 0);
  if (!Number.isFinite(tip) || tip < 0 || received < 0) {
    throw posValidationError_('Revisa el efectivo recibido y la propina.');
  }
  if (received + 0.001 < due + tip) {
    throw posValidationError_('Efectivo insuficiente: faltan $' + posRound_(due + tip - received).toFixed(2) + '.');
  }
  return { sale: due, received: received, tip: tip, change: posRound_(received - due - tip) };
}

// Only cash plus one terminal, all amounts in whole cents. Terminal approval is
// an operator assertion, not a bank/terminal integration. Tip belongs to cash.
function posMixedPaymentMath_(due,p) {
  const cents=v=>typeof v==='number' && Number.isFinite(v) && v>=0 && Number.isSafeInteger(Math.round(v*100)) && Math.abs(v*100-Math.round(v*100))<0.00001?Math.round(v*100):null;
  const parts=p.payments,total=cents(due),received=cents(p.received),tip=cents(p.tip);
  if(!Array.isArray(parts) || parts.length!==2 || !parts[0] || !parts[1] || parts[0].method!=='Efectivo' || !['Terminal 1','Terminal 2'].includes(parts[1].method) ||
      total===null || cents(p.expectedTotal)!==total || received===null || tip===null ||
      parts.some(v=>cents(v.amount)===null || cents(v.amount)<=0) || cents(parts[0].amount)+cents(parts[1].amount)!==total) {
    throw posValidationError_('Mixto requiere efectivo y una terminal, importes positivos con dos decimales y suma exacta del saldo.');
  }
  if(p.terminalConfirmed!==true || typeof p.terminalReference!=='string' || !p.terminalReference.trim() || p.terminalReference.length>120 || /[\x00-\x1f\x7f]/.test(p.terminalReference)) {
    throw posValidationError_('Confirma la aprobación de la terminal e indica su referencia antes de registrar el pago mixto.');
  }
  const change=received-cents(parts[0].amount)-tip;
  if(change<0)throw posValidationError_('Efectivo insuficiente para su parte de la cuenta y la propina.');
  return {sale:due,received:p.received,tip:p.tip,change:change/100,payments:parts,terminalReference:p.terminalReference.trim()};
}

function posExpandCart_(items, cat, phase, canCourtesy) {
  if (!Array.isArray(items) || !items.length) throw posValidationError_('Pedido vacío o inválido.');
  const units = [];
  const catalogRows = posCatalogRows_(cat);

  for (const item of items) {
    if (!item || typeof item !== 'object') throw posValidationError_('Producto inválido.');
    const matches = catalogRows.filter(r => item.sku ? String(r[6]) === String(item.sku) : r[0] === item.name);
    if (matches.length !== 1) throw posValidationError_('PRODUCT_NOT_FOUND: referencia inexistente, inactiva o ambigua.');
    const c = matches[0];
    const rawPrice = c[15] ? c[phase === 'Solar' ? 16 : 17] : c[2];
    const price = Number(rawPrice);
    const qty = Number(item.qty);
    if (rawPrice === '' || rawPrice == null || !Number.isFinite(price) || price < 0) throw posValidationError_('Precio de catálogo inválido.');
    if (!Number.isInteger(qty) || qty < 1 || qty > 20) throw posValidationError_('Cantidad debe ser entera entre 1 y 20.');
    if (item.courtesy && !canCourtesy) throw posValidationError_('Acceso denegado: cortesía requiere Gerencia.');

    for (let j = 0; j < qty; j++) {
      units.push({
        name: c[0],
        group: c[1] || 'General',
        price: price,
        courtesy: !!item.courtesy,
        share: c[3] || 0,
        beneficiary: c[4] || 'DOMUS',
        inventory: c[6] || '',
        sku: c[6] || '',
        notes: String(item.notes || '').slice(0, 500),
        destination: c[7] || (c[1] === 'Alimentos' ? 'Cocina' : 'Barra')
      });
    }
  }
  if (units.length > 50) throw posValidationError_('Máximo 50 unidades por operación.');
  return units;
}


