'use strict';

/**
 * Estados del ciclo de vida de una solicitud transaccional
 */
const REQUEST_STATUS = Object.freeze({
  PROCESSING: 'PROCESSING',
  COMPLETED: 'COMPLETED',
  FAILED: 'FAILED',
  REQUIRES_REVIEW: 'REQUIRES_REVIEW'
});

let _scriptLockDepth = 0;

/**
 * Ejecuta una función dentro de una sección crítica protegida con LockService
 * Garantiza que dos peticiones simultáneas no colisionen ni corrompan el libro
 * Maneja re-entrancia segura: sólo el nivel superior adquiere y libera el script lock físico,
 * evitando que llamadas anidadas (ej. idempotentExecute_ -> cajaSimpleRegistrar) liberen el lock prematuramente.
 */
function withLock_(timeoutMs, fn) {
  const timeout = typeof timeoutMs === 'number' ? timeoutMs : (CONFIG.lockTimeoutMs || 30000);
  const lock = LockService.getScriptLock();
  
  const isTopLevel = (_scriptLockDepth === 0);
  if (isTopLevel) {
    try {
      lock.waitLock(timeout);
    } catch (err) {
      throw new Error('El sistema se encuentra procesando otra transacción concurrente. Por favor reintenta en un momento.');
    }
  }
  _scriptLockDepth++;

  try {
    return fn();
  } finally {
    _scriptLockDepth--;
    if (isTopLevel && _scriptLockDepth === 0) {
      try {
        lock.releaseLock();
      } catch (e) {
        console.warn('Error al liberar candado de Apps Script:', e);
      }
    }
  }
}

/**
 * Genera una representación canónica y determinista de un objeto (JSON con claves ordenadas)
 */
function canonicalJsonStringify_(obj) {
  if (obj === null || typeof obj !== 'object') {
    return JSON.stringify(obj);
  }
  if (Array.isArray(obj)) {
    return '[' + obj.map(canonicalJsonStringify_).join(',') + ']';
  }
  const keys = Object.keys(obj).sort();
  const parts = keys.map(k => JSON.stringify(k) + ':' + canonicalJsonStringify_(obj[k]));
  return '{' + parts.join(',') + '}';
}

/**
 * Calcula un hash criptográfico SHA-256 determinista del contenido de la petición
 */
function computePayloadHash_(payload) {
  try {
    const canonicalStr = canonicalJsonStringify_(payload !== undefined ? payload : null);
    if (typeof Utilities !== 'undefined' && Utilities.computeDigest) {
      const rawHash = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, canonicalStr, Utilities.Charset.UTF_8);
      let hashHex = '';
      for (let i = 0; i < rawHash.length; i++) {
        let b = rawHash[i];
        if (b < 0) b += 256;
        let s = b.toString(16);
        if (s.length === 1) s = '0' + s;
        hashHex += s;
      }
      return hashHex;
    }
    // Fallback simple para tests unitarios locales sin objeto Utilities
    let hash = 0;
    for (let i = 0; i < canonicalStr.length; i++) {
      hash = ((hash << 5) - hash) + canonicalStr.charCodeAt(i);
      hash |= 0;
    }
    return 'sha256-fallback-' + Math.abs(hash).toString(16);
  } catch (e) {
    return 'hash-error-' + Date.now();
  }
}

/**
 * Obtiene o crea la hoja de auditoría de peticiones (REQUESTS / TRANSACCIONES_API)
 */
function getOrCreateRequestsSheet_(spreadsheet) {
  try {
    const ss = spreadsheet || SpreadsheetApp.openById(CONFIG.mainSheetId);
    let sheet = ss.getSheetByName('REQUESTS') || ss.getSheetByName('TRANSACCIONES_API');
    if (!sheet) {
      sheet = ss.insertSheet('REQUESTS');
      const headers = [
        'REQUEST_ID', 'ACTION', 'PAYLOAD_HASH', 'DEVICE_ID',
        'STATUS', 'CREATED_AT', 'COMPLETED_AT', 'RESPONSE'
      ];
      sheet.appendRow(headers);
      sheet.setFrozenRows(1);
      sheet.getRange(1, 1, 1, headers.length).setFontWeight('bold');
    }
    return sheet;
  } catch (e) {
    console.warn('[IDEMPOTENCY] No se pudo acceder/crear hoja REQUESTS:', e);
    return null;
  }
}

/**
 * Busca un registro previo en las 3 capas:
 * 1) Cache rápida (ScriptCache)
 * 2) Almacén de ScriptProperties
 * 3) Hoja de cálculo REQUESTS
 */
function findRequestRecord_(cleanReqId, spreadsheet) {
  const sheet = getOrCreateRequestsSheet_(spreadsheet);
  if (!sheet) throw new Error('LEDGER_UNAVAILABLE');
  const rows = dataRows_(sheet, 2, 8);
  const found = [];
  rows.forEach((r, i) => {
    if (String(r[0]).trim() === cleanReqId) found.push({
      requestId: cleanReqId, action: String(r[1]), payloadHash: String(r[2]),
      deviceId: String(r[3]), status: String(r[4]), createdAt: r[5], completedAt: r[6],
      response: r[7] ? JSON.parse(r[7]) : null, sheetRowIndex: i + 2
    });
  });
  if (found.length > 1) throw new Error('LEDGER_DUPLICATE_REQUIRES_REVIEW');
  return found[0] || null;
}

/**
 * Guarda o actualiza un registro en el ledger (Cache, Properties y Hoja REQUESTS)
 */
function saveRequestRecord_(record, spreadsheet) {
  const sheet = getOrCreateRequestsSheet_(spreadsheet);
  if (!sheet) throw new Error('LEDGER_UNAVAILABLE');
  // The durable ledger is authoritative. No cache can publish completion before Sheets.
  if (!record.sheetRowIndex) record.sheetRowIndex = Math.max(2, sheet.getLastRow() + 1);
  sheet.getRange(record.sheetRowIndex, 1, 1, 8).setValues([[
    record.requestId, record.action, record.payloadHash, record.deviceId,
    record.status, record.createdAt, record.completedAt || '', JSON.stringify(record.response)
  ]]);
  SpreadsheetApp.flush();
}

/**
 * Ejecuta una operación mutativa garantizando:
 * 1. Deduplicación estricta por requestId
 * 2. Vinculación criptográfica de contenido (action + payloadHash + deviceId)
 * 3. Rechazo inmediato con 409 IDEMPOTENCY_KEY_REUSED si un requestId se reutiliza con distinto payload
 * 4. Registro continuo de estados: PROCESSING -> COMPLETED / FAILED / REQUIRES_REVIEW
 */
function idempotentExecute_(requestId, action, payload, deviceId, fn) {
  if (!requestId || typeof requestId !== 'string' || !requestId.trim()) throw new Error('REQUEST_ID_REQUIRED');
  const cleanReqId = requestId.trim();
  const currentPayloadHash = computePayloadHash_({ action: action, payload: payload });
  const devId = String(deviceId || '');
  if (!devId) throw new Error('DEVICE_ID_REQUIRED');
  return withLock_(CONFIG.lockTimeoutMs, () => {
    const m = SpreadsheetApp.openById(CONFIG.mainSheetId);
    const prior = findRequestRecord_(cleanReqId, m);
    if (prior && (prior.payloadHash !== currentPayloadHash || prior.action !== action || prior.deviceId !== devId)) {
      const err = new Error('IDEMPOTENCY_KEY_REUSED'); err.status = 409; err.code = 'IDEMPOTENCY_KEY_REUSED'; throw err;
    }
    if (prior && prior.status === REQUEST_STATUS.COMPLETED) return prior.response;
    if (prior) {
      const resumed = journalResume_(cleanReqId, action, m);
      if (resumed) {
        prior.status = REQUEST_STATUS.COMPLETED; prior.response = resumed;
        prior.completedAt = new Date().toISOString(); saveRequestRecord_(prior, m); return resumed;
      }
      // Old code may have written effects before FAILED. Never rerun it blindly.
      const err = new Error('IDEMPOTENCY_REQUIRES_REVIEW: intención previa sin plan recuperable.');
      err.status = 409; err.code = 'IDEMPOTENCY_REQUIRES_REVIEW'; throw err;
    }
    const record = {requestId: cleanReqId, action: action, payloadHash: currentPayloadHash,
      deviceId: devId, status: REQUEST_STATUS.PROCESSING, createdAt: new Date().toISOString(), response: null};
    saveRequestRecord_(record, m);
    try {
      const result = fn();
      record.status = REQUEST_STATUS.COMPLETED; record.response = result;
      record.completedAt = new Date().toISOString(); saveRequestRecord_(record, m); return result;
    } catch (err) {
      record.status = REQUEST_STATUS.REQUIRES_REVIEW;
      record.response = {error: String(err.message || err)};
      record.completedAt = new Date().toISOString(); saveRequestRecord_(record, m); throw err;
    }
  });
}


// MODULE Accounts
/**
 * ============================================================================
 * DOMUS OS · CUSTOMER ACCOUNTS & BALANCES (Accounts.gs)
 * Gestión de saldos de cuentas abiertas, aperturas, autorizaciones y cierres
 * ============================================================================
 */

'use strict';

function accountKey_(ticket) {
  return 'cuenta:' + Utilities.base64EncodeWebSafe(String(ticket));
}

function account_(ticket) {
  const raw = PropertiesService.getScriptProperties().getProperty(accountKey_(ticket));
  return JSON.parse(raw || '{}');
}

function putAccount_(ticket, a) {
  PropertiesService.getScriptProperties().setProperty(accountKey_(ticket), JSON.stringify(a));
}

function posBalanceFast_(x, ticket) {
  const sCaja = x.c || x.m.getSheetByName('CAJA 2');
  const sCobros = x.m.getSheetByName('COBROS');

  const rows = dataRows_(sCaja, 7, 32)
    .filter(r => String(r[1]) === String(ticket) && r[6] && r[15] !== 'Cancelado');

  const total = rows.reduce((n, r) => n + (Number(r[11]) || 0), 0);

  const paid = dataRows_(sCobros, 7, 14)
    .filter(r => r[2] === 'Caja' && String(r[3]) === String(ticket))
    .reduce((n, r) => n + paymentApplied_(r), 0);

  return {
    rows: rows,
    total: posRound_(total),
    paid: posRound_(paid),
    due: posRound_(total - paid)
  };
}

function closeCashAccount_(x, ticket, who) {
  const b = posBalanceFast_(x, ticket);
  if (b.due > 0.01) {
    throw new Error(`No se puede cerrar la cuenta '${ticket}'. Presenta un saldo pendiente de $${b.due.toFixed(2)}.`);
  }

  const a = account_(ticket);
  a.closed = true;
  a.closedBy = who;
  a.closedAt = new Date().toISOString();
  putAccount_(ticket, a);

  return { ok: true, ticket: ticket, message: `Cuenta '${ticket}' cerrada formalmente por ${who}.` };
}

function reopenCashAccount_(ticket, who, reason) {
  if (!reason || !String(reason).trim()) {
    throw new Error('El motivo de reapertura es obligatorio para auditoría.');
  }

  const a = account_(ticket);
  a.closed = false;
  a.events = a.events || [];
  a.events.push({
    action: 'Reabrir',
    who: who,
    reason: String(reason).trim(),
    at: new Date().toISOString()
  });
  putAccount_(ticket, a);

  return { ok: true, ticket: ticket, message: `Cuenta '${ticket}' reabierta con éxito.` };
}


// MODULE Payments
/**
 * ============================================================================
 * DOMUS OS · PAYMENTS & CONCILIATION (Payments.gs)
 * Registro de transacciones en COBROS, validación de medios de pago y folios
 * ============================================================================
 */

'use strict';

function paymentWrites_(sheet, p) {
  schemaColumns_(sheet, ['Folio cobro','Puesto / origen','TICKET / referencia BOL','IMPORTE COBRADO','Revisión','Cobrado aplicado']);
  if (!Number.isFinite(Number(p.amount)) || Number(p.amount) <= 0) throw new Error('Importe inválido.');
  const row = p.row || Math.max(sheet.getLastRow()+1, 7);
  const inputs = {1:p.folio,2:new Date(),3:p.origin,4:p.ticket,5:p.method,6:p.amount,
    7:p.method==='Efectivo'?0:'',9:p.tag,11:p.method==='Transferencia'?'Borrador':'Confirmado',
    12:p.operator,16:p.activity,29:p.tip||0,30:p.received==null?'':p.received,31:p.change==null?'':p.change};
  // Keep semantic columns: H net, M review, N applied, O net applied, never customer/amount shifted.
  inputs[8] = '=F'+row+'-N(G'+row+')';
  inputs[13] = '=IF(K'+row+'="Borrador","TRANSFERENCIA POR VERIFICAR","LISTO")';
  inputs[14] = '=IF(K'+row+'="Confirmado",F'+row+',0)';
  inputs[15] = '=IF(N'+row+'>0,N'+row+'-N(G'+row+'),0)';
  return Object.keys(inputs).map(c => cellWrite_(sheet,row,Number(c),inputs[c],[8,13,14,15].includes(Number(c))));
}

/**
 * Registra un cobro asentado en la hoja maestra COBROS
 */
function recordPaymentTransaction_(m, payload) {
  authRequireContext_('cajaSimpleRegistrar');
  const id=String(payload.requestId || '');
  const folio=payload.folio || 'REC-'+Utilities.getUuid();
  const values=paymentWrites_(m.getSheetByName('COBROS'),Object.assign({},payload,{folio:folio}));
  return journalCommit_(id,'recordPaymentTransaction',m,values,{folio:folio,amount:payload.amount,method:payload.method});
}


// MODULE POS
/**
 * ============================================================================
 * DOMUS OS · POINT OF SALE & REGISTER (POS.gs)
 * Lógica transaccional de ventas, caja, cálculo de cobro y despacho de órdenes
 * ============================================================================
 */

'use strict';

const EVENT_30OCT_ACTIVITY = 'Del Crepúsculo al Amanecer';
const EVENT_30OCT_PRICE_SHEET = 'EVENTO_30OCT_PRECIOS';

function posActiveActivity_(m) {
  const settings = m.getSheetByName('DOMUS_SETTINGS');
  return settings ? String(settings.getRange(1, 2).getValue() || '').trim() : '';
}

function posEventPrices_(m, activity) {
  const map = new Map();
  if (String(activity || '').trim() !== EVENT_30OCT_ACTIVITY) return map;
  const sheet = m.getSheetByName(EVENT_30OCT_PRICE_SHEET);
  if (!sheet) throw new Error('EVENT_PRICE_SHEET_MISSING');
  dataRows_(sheet, 4, 9).forEach(r => {
    const key = String(r[2] || '').trim();
    if (!key) return;
    const base = Number(r[5]);
    const eventPrice = Number(r[6]);
    const extra = Number(r[7]);
    if (![base, eventPrice, extra].every(Number.isFinite) || base < 0 || eventPrice < base || Math.abs((eventPrice - base) - extra) > 0.01) {
      throw new Error('EVENT_PRICE_INVALID: ' + key);
    }
    map.set(key, { base: base, price: eventPrice, extra: extra, beneficiary: 'Universidad del Swinger' });
  });
  if (!map.size) throw new Error('EVENT_PRICE_TABLE_EMPTY');
  return map;
}

/**
 * Consulta de datos para la vista de Caja: productos activos, fase y cuentas abiertas
 */
function cajaSimpleDatos() {
  authRequireContext_('cajaSimpleDatos');
  const m = SpreadsheetApp.openById(CONFIG.mainSheetId);
  const s = m.getSheetByName('CAJA 2');
  const phase = String(s.getRange('F2').getValue()) || 'Solar';
  const sheetCat = m.getSheetByName('CATALOGO');
  const lastRowCat = sheetCat ? sheetCat.getLastRow() : 6;
  const numRowsCat = Math.max(1, lastRowCat - 6);
  const cat = sheetCat ? sheetCat.getRange(7, 1, numRowsCat, 20).getValues() : [];
  const activeActivity = posActiveActivity_(m);
  const eventPrices = posEventPrices_(m, activeActivity);

  // Filtrar catálogo activo
  const products = [];
  posCatalogRows_(cat).forEach(r => {
    if (r[0] && r[8] === 'Sí') {
      const basePrice = r[15] ? r[phase === 'Solar' ? 16 : 17] : r[2];
      if (typeof basePrice === 'number' && basePrice >= 0) {
        const sku = String(r[6] || '');
        const special = eventPrices.get(sku);
        if (special && Math.abs(Number(basePrice) - special.base) > 0.01) throw new Error('EVENT_BASE_PRICE_MISMATCH: ' + sku);
        const price = special ? special.price : Number(basePrice);
        const provider = String(r[4] || '');
        const isCanna = sku.toUpperCase().indexOf('CT') === 0 || provider.toLowerCase().indexOf('canna') !== -1;
        products.push({
          name: String(r[0]),
          group: String(r[1] || 'General'),
          price: price,
          basePrice: Number(basePrice),
          eventExtra: special ? special.extra : 0,
          eventExtraBeneficiary: special ? special.beneficiary : '',
          priceSolar: r[15] ? Number(r[16]) : Number(r[2]),
          priceLunar: special ? special.price : (r[15] ? Number(r[17]) : Number(r[2])),
          destination: String(r[7] || (isCanna ? 'Cocina' : (r[1] === 'Alimentos' ? 'Cocina' : 'Barra'))),
          sku: sku,
          provider: provider
        });
      }
    }
  });

  // Cuentas abiertas y saldos
  const map = new Map();
  const cashRows = dataRows_(s, 7, 16);
  cashRows.forEach(r => {
    if (r[1] && r[6] && r[15] !== 'Cancelado') {
      const key = String(r[1]);
      let a = map.get(key);
      if (!a) {
        a = { ticket: key, customer: String(r[4] || ''), activity: String(r[3] || 'Visita general DOMUS'), due: 0 };
        map.set(key, a);
      }
      a.due += Number(r[11]) || 0;
    }
  });

  const payments = dataRows_(m.getSheetByName('COBROS'), 7, 14);
  payments.forEach(r => {
    if (r[2] === 'Caja' && map.has(String(r[3]))) {
      map.get(String(r[3])).due -= paymentApplied_(r);
    }
  });

  const accounts = Array.from(map.values())
    .map(a => {
      a.due = Math.round(a.due * 100) / 100;
      return a;
    })
    .filter(a => a.due > 0.01);

  const activities = Array.from(new Set([
    'Visita general DOMUS',
    ...dataRows_(m.getSheetByName('ACTIVIDADES'), 7, 2).filter(r => r[0]).map(r => String(r[0]))
  ]));

  const lastPay = payments.filter(r => r[2] === 'Caja' && Number(r[13]) > 0).slice(-1)[0];
  const lastReceipt = lastPay 
    ? 'Último cobro: ' + (map.get(String(lastPay[3])) || { customer: lastPay[3] }).customer + ' · $' + Number(lastPay[13]).toFixed(2) + ' · ' + lastPay[4] 
    : '';

  return {
    phase: ['Solar', 'Lunar'].includes(phase) ? phase : 'Solar',
    products: products,
    accounts: accounts,
    activities: activities,
    activeActivity: activeActivity,
    activityLocked: activeActivity === EVENT_30OCT_ACTIVITY,
    lastReceipt: lastReceipt,
    staff: CONFIG.staff,
    canCourtesy: typeof _authContext !== 'undefined' && !!_authContext && ['ADMIN', 'GERENCIA'].includes(_authContext.role)
  };
}

/**
 * Registra una venta en Caja (inmediata o a cuenta abierta) con control atómico de concurrencia
 */
function cajaSimpleRegistrar(p) {
  authRequireContext_('cajaSimpleRegistrar');
  if (!p) throw new Error('Cuerpo de venta vacío.');
  const id = String(p.requestId || p.id || '').trim();
  if (!id) throw new Error('REQUEST_ID_REQUIRED');
  p.id = id;

  return withLock_(CONFIG.lockTimeoutMs, () => {
    return cajaSimpleRegistrarCore_(p);
  });
}

function cajaSimpleRegistrarCore_(p) {
  authRequireContext_('cajaSimpleRegistrar');
  const m = SpreadsheetApp.openById(CONFIG.mainSheetId);
  const replay = journalResume_(p.id, 'cajaSimpleRegistrar', m);
  if (replay) return replay;
  const sCaja = m.getSheetByName('CAJA 2');
  const sCobros = m.getSheetByName('COBROS');
  const sComandas = m.getSheetByName('COMANDAS');
  schemaColumns_(sCaja, ['CUENTA AUTOMÁTICA','Producto','TOTAL','PAGADO','SALDO','Preparación / entrega','Extra evento autorizado','Beneficiario extra','Extra evento cobrado']);
  schemaColumns_(sComandas, ['Registro de sincronización','PREPARACIÓN / ENTREGA']);
  const phase = String(sCaja.getRange('F2').getValue());
  if (!['Solar','Lunar'].includes(phase) || p.phase !== phase) throw new Error('Cambió la carta. Actualiza antes de cobrar.');
  const who = _authContext.operator;
  const canCourtesy = ['ADMIN','GERENCIA'].includes(_authContext.role);
  const ticket = String(p.ticket || ('CTA-' + Utilities.getUuid())).trim();
  const oldBalance = p.ticket ? posBalanceFast_({m:m,c:sCaja}, ticket) : {total:0,paid:0,due:0,rows:[]};
  if (p.ticket && !oldBalance.rows.length) throw new Error('Cuenta no encontrada.');
  const customer = String(p.ticket ? oldBalance.rows[0][4] : p.customer || 'Público General').trim();
  const activity = String(p.ticket ? oldBalance.rows[0][3] : p.activity || 'Visita general DOMUS').trim();
  const activeActivity = posActiveActivity_(m);
  if (p.items && p.items.length && activeActivity === EVENT_30OCT_ACTIVITY && activity !== activeActivity) {
    throw new Error('ACTIVE_EVENT_MISMATCH: actualiza Caja y usa el evento activo.');
  }
  const cat = dataRows_(m.getSheetByName('CATALOGO'), 7, 20);
  const eventPrices = posEventPrices_(m, activity);
  const units = p.items && p.items.length ? posExpandCart_(p.items, cat, phase, canCourtesy, eventPrices) : [];
  if (!units.length && (!p.ticket || !p.paid)) throw new Error('Pedido vacío.');
  const added = posRound_(units.reduce((n,u) => n + (u.courtesy ? 0 : u.price),0));
  const due = posRound_(Math.max(0, oldBalance.due) + added);
  if (p.paid && due <= 0.01) throw new Error('Cuenta sin saldo pendiente. No repetir cobro.');
  if (!p.paid && !['Amigo','Creador de proyecto'].includes(p.credit)) throw new Error('Autorización de crédito requerida.');
  const method = String(p.method || '');
  const math = p.paid ? posPaymentMath_(due, method, p.received, p.tip) : {sale:0,tip:0,received:null,change:null};
  if (p.paid && p.expectedTotal != null && Math.abs(Number(p.expectedTotal)-due)>0.01) throw new Error('Saldo cambió. Actualiza la cuenta antes de confirmar.');
  const pending = !!p.paid && method === 'Transferencia';
  const confirmed = !!p.paid && !pending;
  const rows = dataRows_(sCaja,7,32);
  const free = [];
  rows.forEach((r,i) => { if (!r[1] && !r[6] && free.length < units.length) free.push(i+7); });
  let nextRow=Math.max(sCaja.getLastRow()+1,7);
  while (free.length < units.length) free.push(nextRow++);
  const writes = [];
  const now = new Date();
  units.forEach((u,i) => {
    const row = free[i];
    const inputs = {1:'U-'+row,2:ticket,3:now,4:activity,5:customer,6:u.group,7:u.name,8:1,
      9:u.courtesy?'Cortesía':'Normal',10:u.basePrice,11:u.price !== u.basePrice ? u.price : '',16:'Enviar',17:u.notes,
      18:u.share,19:u.beneficiary,21:u.inventory,25:u.destination,
      48:u.eventExtra || 0,49:u.eventExtra ? u.extraBeneficiary : ''};
    if (u.courtesy) inputs[31] = who;
    Object.keys(inputs).forEach(c => writes.push(cellWrite_(sCaja,row,Number(c),inputs[c])));
    writes.push(...cashFormulaWrites_(sCaja,row));
    const item = {id:'U-'+row,row:row,ticket:ticket,batch:p.id,alias:customer,product:u.name,
      sku:u.sku,qty:1,notes:u.notes,destination:u.destination,sent:now.toISOString(),
      state:'Pendiente',credit:!confirmed,incident:'',responsible:''};
    const com = {1:'U-'+row,2:ticket,3:now,4:u.destination,5:u.name,6:1,7:u.notes,8:'Recibida',13:JSON.stringify(item)};
    Object.keys(com).forEach(c => writes.push(cellWrite_(sComandas,row,Number(c),com[c])));
  });
  let receipt = '';
  if (p.paid) {
    receipt = 'REC-'+Utilities.getUuid();
    writes.push(...paymentWrites_(sCobros, {
      folio:receipt, origin:'Caja',ticket:ticket, method:method,amount:due,tag:'CAJA-RAPIDA:'+p.id,
      operator:who,activity:activity,tip:math.tip,received:math.received,change:math.change
    }));
  }
  const result = {ok:true,ticket:ticket,receipt:receipt,paid:confirmed,verified:confirmed,
    paymentStatus:pending?'PENDIENTE_VERIFICACION':(confirmed?'CONFIRMADA':'CUENTA_ABIERTA'),
    method:method,total:due,customer:customer,received:math.received,tip:math.tip,change:math.change,
    items: units.map(u=>({name:u.name,qty:1,price:u.courtesy?0:u.price,basePrice:u.basePrice,eventExtra:u.courtesy?0:u.eventExtra,eventExtraBeneficiary:u.eventExtra?u.extraBeneficiary:''})),
    message:pending?'PAGO POR TRANSFERENCIA PENDIENTE DE VERIFICACIÓN':(confirmed?'Cobro confirmado.':'Pedido enviado a cuenta abierta.')};
  return journalCommit_(p.id,'cajaSimpleRegistrar',m,writes,result);
}

/**
 * Consulta de confirmación rápida (solo lectura) para reconectar operaciones interrumpidas
 */
function cajaSimpleEstado(id) {
  authRequireContext_('cajaSimpleEstado');
  if (!id) throw new Error('Referencia de operación requerida.');
  const prior = findRequestRecord_(String(id));
  if (prior && prior.status === REQUEST_STATUS.COMPLETED) return {done:true,result:prior.response};
  const journal = journalFind_(String(id),SpreadsheetApp.openById(CONFIG.mainSheetId));
  if (journal && journal.data[2] === 'COMPLETED') return {done:true,result:JSON.parse(journal.data[4])};
  const props = PropertiesService.getScriptProperties();
  const raw = props.getProperty('cajaSimple:' + id) || props.getProperty('idemp:' + id);
  if (raw) {
    try {
      const record = JSON.parse(raw);
      if (record.done) return { done: true, result: record.result || record };
    } catch (e) {}
  }
  return { done: false, message: 'Operación en proceso de confirmación…' };
}

