nge(target+7,12).setValue(who||'Caja');cob.getRange(target+7,11).setValue('Confirmado');}SpreadsheetApp.flush();if(cob.getRange(target+7,5).getValue()==='Transferencia'&&Number(cob.getRange(target+7,14).getValue())<=0){holdTransferReceipt_(x,x.c,row,35,target+7);return;}if(Number(cob.getRange(target+7,14).getValue())<=0)throw Error('Revisa el cobro en COBROS: '+cob.getRange(target+7,13).getDisplayValue());cell.setNote('REGISTRADO:'+JSON.stringify({folio:cob.getRange(target+7,1).getDisplayValue(),amount:Number(cob.getRange(target+7,6).getValue()),method:cob.getRange(target+7,5).getValue(),ticket,tag}));cell.setValue(true);x.m.toast('Cobro registrado. Si elegiste Enviar, el pedido se envía automáticamente.','DOMUS');}
