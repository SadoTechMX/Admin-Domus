function receiptEdit_(x,e){if(e.range.getSheet().getName()!=='CAJA 2'||e.range.getLastColumn()<33||e.range.getColumn()>35)return;for(let row=Math.max(7,e.range.getRow());row<=Math.min(endRow_(),e.range.getLastRow());row++){const cell=x.c.getRange(row,35),note=cell.getNote();if(note.startsWith('POR VERIFICAR:')){const meta=JSON.parse(note.slice('POR VERIFICAR:'.length)),status=refreshPendingTransfer_(x,x.c,row,35);if(status==='pending')x.c.getRange(row,33,1,3).setValues([[meta.method,meta.amount,false]]);continue;}if(!note.startsWith('REGISTRADO:'))continue;const last=JSON.parse(note.slice(11));if(e.range.getColumn()<=34){SpreadsheetApp.flush();if(balance_(x,String(x.c.getRange(row,2).getValue())).due>0.01){cell.setValue(false).clearNote();if(e.range.getLastColumn()<34)x.c.getRange(row,34).clearContent();x.m.toast('Nuevo abono preparado. Revisa el importe y confirma la casilla.','DOMUS');continue;}}x.c.getRange(row,33,1,3).setValues([[last.method,last.amount,true]]);x.m.toast('Cobro '+last.folio+' ya registrado. No se vuelve a cobrar.','DOMUS');}}
