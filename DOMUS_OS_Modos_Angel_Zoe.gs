const DOMUS_CAJA_SIMPLE_HTML="<!doctype html><html lang=\"es\"><head><meta charset=\"utf-8\"><style>\n*{box-sizing:border-box}body{font:14px Arial,sans-serif;margin:0;color:#20242b;background:#f7f5f0}header{padding:15px 22px;background:#20242b;color:white;display:flex;justify-content:space-between;align-items:center}h1{font-size:22px;margin:0}small{display:block;margin-top:4px}.layout{display:grid;grid-template-columns:1.4fr 1fr;gap:18px;padding:18px}.panel{background:white;border:1px solid #dedbd2;border-radius:9px;padding:16px}label{display:block;font-weight:bold;font-size:12px;margin:10px 0 5px}input,select,button{font:inherit}input,select{width:100%;padding:9px;border:1px solid #aaa;border-radius:5px;background:#fff8df}input:focus,select:focus{outline:2px solid #b89a43}button{cursor:pointer;border:0;border-radius:5px;padding:10px 14px;background:#20242b;color:white;font-weight:bold}button:disabled{opacity:.45;cursor:wait}.row{display:grid;grid-template-columns:1fr 1fr;gap:10px}.add{display:grid;grid-template-columns:1fr 85px;gap:10px;align-items:end}.wide{width:100%;margin-top:12px}.pay{background:#17633e;font-size:16px;padding:14px}.muted{color:#61656a;font-size:12px}.money{font-size:35px;font-weight:bold;margin:7px 0 15px}.change{background:#e7f1f9;border-radius:6px;padding:12px;margin:12px 0;font-size:18px}.notice{margin:0 18px 12px;padding:12px;white-space:pre-line;border-radius:6px;background:#edf2f5;line-height:1.4}.error{background:#ffe6df;color:#7b210d}.success{background:#e4f3e6;color:#174d2c}table{width:100%;border-collapse:collapse;margin-top:14px}th,td{text-align:left;padding:8px 4px;border-bottom:1px solid #ddd}td:last-child,th:last-child{text-align:right}.remove{padding:2px 8px;background:#eee;color:#333}.summary{font-weight:bold;text-align:right;margin-top:10px}.hidden{display:none}.headbtn{background:#4c525c;font-size:12px}.readonly{background:#eef2f5}#basket{max-height:200px;overflow:auto}#activity{font-size:12px}.loader{padding:35px;text-align:center}.busy{pointer-events:none;opacity:.7}.line{border-top:1px solid #ddd;margin-top:14px;padding-top:12px}\n@media(min-width:1100px){.layout{max-width:1120px;margin:auto}header{padding-left:max(22px,calc((100vw - 1080px)/2));padding-right:max(22px,calc((100vw - 1080px)/2))}.notice{max-width:1084px;margin:0 auto 15px}}@media(max-width:700px){.layout{grid-template-columns:1fr;padding:10px;gap:10px}header{padding:12px}h1{font-size:19px}.row{grid-template-columns:1fr}.money{font-size:30px}}\n.quickgrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin-top:10px}.productkey{background:#fff;color:#20242b;border:1px solid #cfc9bb;text-align:left;min-height:66px;padding:10px;line-height:1.25;font-size:13px}.productkey strong{display:block;color:#17633e;margin-top:5px;font-size:16px}.methods{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin:8px 0}.methodkey{background:#eee;color:#20242b;border:2px solid transparent}.methodkey[aria-pressed=\"true\"]{background:#e4f3e6;border-color:#17633e;color:#174d2c}.shortcuts{display:flex;gap:6px;flex-wrap:wrap;margin:8px 0}.shortcuts button{background:#ece9e1;color:#20242b;padding:8px 11px}.quantitybtn{background:#eee;color:#333;padding:4px 10px}.qtycell{white-space:nowrap}details{border-top:1px solid #e3dfd5;margin-top:15px;padding-top:12px}summary{cursor:pointer;font-weight:bold;font-size:13px}.sectiontitle{margin:0 0 8px;font-size:17px}#search{font-size:17px}#basket{max-height:235px}.pay{margin-top:5px}.money{margin-bottom:8px}#resultsHint{margin-top:7px}.minor{background:#e9e5db;color:#444;font-size:12px}#quantity{max-width:85px}@media(max-width:450px){.quickgrid{grid-template-columns:1fr}.productkey{min-height:55px}}\n</style></head><body><header><div><h1>DOMUS · Caja simple</h1><small>Pedido, pago y cambio · Caja directa v8 - catalogo completo</small></div><div><span id=\"phase\">Cargando…</span> <button class=\"headbtn\" onclick=\"load()\">Actualizar</button></div></header>\n<div id=\"loading\" class=\"loader\">Consultando productos y cuentas…</div><main id=\"main\" class=\"layout hidden\"><section class=\"panel\"><h2 class=\"sectiontitle\">1 · Cliente y productos</h2><div class=\"row\"><div><label for=\"customer\">Nombre y apellido / apodo</label><input id=\"customer\" autocomplete=\"off\" placeholder=\"¿A nombre de quién?\"></div><div><label for=\"activity\">Actividad del cliente</label><select id=\"activity\"></select></div></div><div class=\"add\"><div><label for=\"search\">Buscar producto y pulsar para agregar</label><input id=\"search\" placeholder=\"Ej. Victoria, Paloma, café…\" oninput=\"products()\" onkeydown=\"if(event.key==='Enter'){event.preventDefault();add()}\"></div><div><label for=\"quantity\">Cantidad</label><input id=\"quantity\" type=\"number\" min=\"1\" max=\"20\" value=\"1\"></div></div><div id=\"quickProducts\" class=\"quickgrid\"></div><div id=\"resultsHint\" class=\"muted\"></div><select id=\"product\" class=\"hidden\" aria-label=\"Resultado de búsqueda\"></select><div id=\"basket\"><table><thead><tr><th>Pedido</th><th>Cant.</th><th>Importe</th><th></th></tr></thead><tbody id=\"cart\"></tbody></table></div><div class=\"summary\" id=\"subtotal\">Productos nuevos: $0.00</div><div id=\"existing\" class=\"muted\"></div><details><summary>Filtrar categoría · Staff · Cortesías</summary><label for=\"group\">Categoría / tarifa staff</label><select id=\"group\" onchange=\"products()\"></select><label for=\"consumption\">Tipo de consumo</label><select id=\"consumption\" onchange=\"products()\"><option value=\"Normal\">Normal</option><option value=\"Cortesía\">Cortesía de gerencia</option></select><p class=\"muted\">Selecciona el tipo de consumo antes de agregar el producto. Las cortesías requieren autorización de gerencia.</p></details><details id=\"accountOptions\"><summary>Cuenta existente · Pagar al final</summary><label for=\"account\">Cliente o cuenta</label><select id=\"account\" onchange=\"choose()\"><option value=\"\">Nueva cuenta</option></select><label for=\"credit\">Cuenta al final · sólo amigos o creadores</label><select id=\"credit\"><option value=\"\">Público general · paga antes de preparar</option><option value=\"Amigo\">Amigo · puede pagar al final</option><option value=\"Creador de proyecto\">Creador de proyecto · puede pagar al final</option></select><button class=\"wide\" onclick=\"submit(false)\">Guardar pedido pendiente</button></details></section><section class=\"panel\"><h2 class=\"sectiontitle\">2 · Registrar pago recibido</h2><div id=\"total\" class=\"money\">$0.00</div><div id=\"methodButtons\" class=\"methods\"><button class=\"methodkey\" data-method=\"Efectivo\" aria-pressed=\"true\" onclick=\"setMethod('Efectivo')\">Efectivo</button><button class=\"methodkey\" data-method=\"Terminal 1\" aria-pressed=\"false\" onclick=\"setMethod('Terminal 1')\">Terminal 1</button><button class=\"methodkey\" data-method=\"Terminal 2\" aria-pressed=\"false\" onclick=\"setMethod('Terminal 2')\">Terminal 2</button><button class=\"methodkey\" data-method=\"Transferencia\" aria-pressed=\"false\" onclick=\"setMethod('Transferencia')\">Transferencia</button></div><select id=\"method\" class=\"hidden\" aria-label=\"Medio de pago\" onchange=\"calc()\"><option value=\"Efectivo\">Efectivo</option><option value=\"Terminal 1\">Terminal 1</option><option value=\"Terminal 2\">Terminal 2</option><option value=\"Transferencia\">Transferencia</option></select><div id=\"cash\"><label for=\"received\">Efectivo recibido</label><input id=\"received\" type=\"number\" min=\"0\" step=\"0.01\" placeholder=\"Lo que entrega el cliente\" oninput=\"calc()\"><div class=\"shortcuts\"><button id=\"exact\" onclick=\"setReceived(due()+Number($('tip').value||0))\">Recibí exacto</button><button onclick=\"setReceived(100)\">$100</button><button onclick=\"setReceived(200)\">$200</button><button onclick=\"setReceived(500)\">$500</button></div><label for=\"tip\">Propina voluntaria</label><input id=\"tip\" type=\"number\" min=\"0\" step=\"0.01\" value=\"0\" oninput=\"calc()\"><div class=\"change\">Cambio: <b id=\"change\">—</b></div></div><p id=\"paymentHelp\" class=\"muted\"></p><button id=\"pay\" class=\"wide pay\" onclick=\"submit(true)\">Registrar pago recibido</button><p class=\"muted\">Registra después de recibir el efectivo o aprobarse la terminal. Steven verifica las transferencias.</p><button class=\"wide minor\" onclick=\"fresh()\">Vaciar pedido sin registrar</button></section></main><div id=\"lastReceipt\" class=\"notice\">Últimos cobros: consultando…</div><div id=\"message\" class=\"notice\">Cargando la operación actual…</div>\n<script>\nlet data=null,cart=[],busy=false,requestId=null,pendingPayload=null;const $=id=>document.getElementById(id),money=n=>new Intl.NumberFormat('es-MX',{style:'currency',currency:'MXN'}).format(n||0);function msg(t,k=''){ $('message').textContent=t;$('message').className='notice '+k;}function state(v){busy=v;document.querySelectorAll('button,input,select').forEach(e=>e.disabled=v);if(!v)chooseLock();}function chooseLock(){let a=data&&data.accounts.find(a=>a.ticket===$('account').value);$('customer').readOnly=!!a;$('activity').disabled=!!a;}function load(keep=''){if(busy)return;state(true);google.script.run.withSuccessHandler(d=>{data=d;$('phase').textContent='Carta '+d.phase;$('account').replaceChildren(new Option('Nueva cuenta',''));d.accounts.forEach(a=>$('account').add(new Option(a.customer+' · '+money(a.due),a.ticket)));$('activity').replaceChildren();d.activities.forEach(a=>$('activity').add(new Option(a,a)));$('group').replaceChildren(new Option('Todos · precios público',''));[...new Set(d.products.map(p=>p.group))].forEach(g=>$('group').add(new Option(g,g)));$('group').value='';if(d.accounts.some(a=>a.ticket===keep))$('account').value=keep;$('loading').classList.add('hidden');$('main').classList.remove('hidden');state(false);products();choose();if(!$('message').classList.contains('success'))msg('Elige una cuenta existente para cobrarla, o agrega productos para una venta nueva.');if(d.lastReceipt)$('lastReceipt').textContent=d.lastReceipt;restorePayment();}).withFailureHandler(e=>{state(false);msg(e.message||String(e),'error')}).cajaSimpleDatos();}function choose(){if(!data)return;const a=data.accounts.find(a=>a.ticket===$('account').value);if(a){$('customer').value=a.customer;$('activity').value=a.activity;$('credit').value=a.credit||'';}else{$('customer').value='';$('activity').value=data.activities.includes('Visita general DOMUS')?'Visita general DOMUS':data.activities[0];$('credit').value='';}chooseLock();calc();}function products(){if(!data)return;const q=$('search').value.toLowerCase().normalize('NFD').replace(/[\\u0300-\\u036f]/g,''),g=$('group').value;let found=data.products.filter(p=>(g?p.group===g:p.group!=='Comida staff')&&p.name.toLowerCase().normalize('NFD').replace(/[\\u0300-\\u036f]/g,'').includes(q));if(!q&&!g)found.sort((a,b)=>quickRank(a.name)-quickRank(b.name));$('product').replaceChildren();found.forEach(p=>$('product').add(new Option(p.name+' · '+money(p.price),p.name)));$('quickProducts').replaceChildren();found.forEach(p=>{let b=document.createElement('button'),label=document.createElement('span'),price=document.createElement('strong');b.className='productkey';label.textContent=p.name;price.textContent=money($('consumption').value==='Cortesía'?0:p.price);b.appendChild(label);b.appendChild(price);b.onclick=()=>{$('product').value=p.name;add()};$('quickProducts').appendChild(b)});$('resultsHint').textContent=found.length===0?'Sin coincidencias. Cambia la búsqueda o categoría.':found.length>10?'Mostrando todos: '+found.length+'. Escribe para encontrar el producto.':'Pulsa el producto para agregarlo.';}\nfunction quickRank(n){if(/^Victoria · 473|^Modelo Especial · lata 473/i.test(n))return 0;if(/^Corona · Cerveza 710|^Caguama|^Volt|^Paloma · Vaso 500|^Cuba · Vaso 500|^Coca-Cola/i.test(n))return 1;return 2;}\nfunction setMethod(m){if(busy||pendingPayload)return;$('method').value=m;calc();}\nfunction setReceived(n){if(busy||pendingPayload)return;$('received').value=Number(n).toFixed(2);calc();}\nfunction paintPaymentButtons(){document.querySelectorAll('[data-method]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.method===$('method').value)));$('exact').textContent='Recibí exacto: '+money(due()+Number($('tip').value||0));}\nfunction add(){if(busy)return;let p=data.products.find(p=>p.name===$('product').value),qty=Number($('quantity').value);if(!p||!Number.isInteger(qty)||qty<1||qty>20){msg('Elige producto y una cantidad entre 1 y 20.','error');return;}if($('consumption').value==='Cortesía'&&!data.canCourtesy){msg('Steven debe autorizar la cortesía desde su cuenta.','error');return;}const courtesy=$('consumption').value==='Cortesía',line=cart.find(c=>c.name===p.name&&c.price===p.price&&c.courtesy===courtesy);if(line&&line.qty+qty>20){msg('Máximo 20 piezas de este producto por renglón.','error');return;}if(line)line.qty+=qty;else cart.push({name:p.name,qty,price:p.price,courtesy});requestId=null;$('quantity').value='1';$('search').value='';products();render();$('search').focus();}function render(){let body=$('cart');body.replaceChildren();cart.forEach((c,i)=>{let row=document.createElement('tr');[c.name+(c.courtesy?' · CORTESÍA':''),String(c.qty),money(c.courtesy?0:c.qty*c.price)].forEach(t=>{let td=document.createElement('td');td.textContent=t;row.appendChild(td)});let td=document.createElement('td'),b=document.createElement('button');b.textContent='×';b.className='remove';b.onclick=()=>{cart.splice(i,1);requestId=null;render()};td.appendChild(b);row.appendChild(td);body.appendChild(row);});calc();}function due(){let a=data&&data.accounts.find(a=>a.ticket===$('account').value);return Math.round(((a?a.due:0)+cart.reduce((n,c)=>n+(c.courtesy?0:c.qty*c.price),0))*100)/100;}function calc(){if(!data)return;const a=data.accounts.find(a=>a.ticket===$('account').value),cash=$('method').value==='Efectivo',total=due();$('subtotal').textContent='Productos nuevos: '+money(cart.reduce((n,c)=>n+(c.courtesy?0:c.qty*c.price),0));$('existing').textContent=a?'Saldo anterior de '+a.customer+': '+money(a.due):'';$('total').textContent=money(total);$('cash').classList.toggle('hidden',!cash);let rec=Number($('received').value),tip=Number($('tip').value);$('change').textContent=$('received').value===''?'—':rec<total+tip?'Falta '+money(total+tip-rec):money(rec-total-tip);$('paymentHelp').textContent=$('method').value==='Transferencia'?'Steven debe verificar que el abono llegó antes de preparar.':cash?'La propina se separa de la venta. Si no alcanza el efectivo, no se registra el cobro.':'Confirma en la terminal el total mostrado. Aquí sólo registras el pago ya recibido.';$('pay').textContent=total===0&&cart.length?'Guardar cortesía autorizada':'Registrar '+money(total)+' · '+$('method').value;paintPaymentButtons();}let pollTimer=null,pollBusy=false;\nfunction pendingStore(p){try{if(p)localStorage.setItem('DOMUS_PENDING_PAYMENT',JSON.stringify(p));else localStorage.removeItem('DOMUS_PENDING_PAYMENT');}catch(e){}}\nfunction finishPayment(r,p){\n if(requestId!==p.id)return;\n if(pollTimer)clearInterval(pollTimer);pollTimer=null;pollBusy=false;pendingStore(null);\n const paid=!!r.paid;data.accounts=data.accounts.filter(a=>a.ticket!==r.ticket);\n if(!paid&&Number(p.expectedTotal)>0)data.accounts.push({ticket:r.ticket,customer:p.customer,activity:p.activity,due:p.expectedTotal,credit:p.credit||''});\n $('account').replaceChildren(new Option('Nueva cuenta',''));data.accounts.forEach(a=>$('account').add(new Option(a.customer+' · '+money(a.due),a.ticket)));\n cart=[];requestId=null;pendingPayload=null;$('received').value='';$('tip').value='0';$('consumption').value='Normal';$('group').value='';$('search').value='';state(false);products();choose();render();$('customer').focus();msg(r.message,'success');\n $('lastReceipt').textContent=(r.receipt?'Folio '+r.receipt+' · ':'')+p.customer+' · '+money(p.expectedTotal)+' · '+(paid?'PAGO REGISTRADO':'PENDIENTE');google.script.run.withSuccessHandler(()=>{}).withFailureHandler(()=>{}).cajaSimplePreparar(p.id);\n}\nlet paymentError=\"\";\nfunction showPaymentError(m){paymentError=m;state(true);busy=false;$('pay').disabled=false;$('pay').textContent='Reintentar misma operación';msg(m+'\\nConservamos el pedido. Reintenta esta misma operación sin volver a pasar la tarjeta.','error');}\nfunction pollPayment(p){\n if(requestId!==p.id||pollBusy)return;pollBusy=true;\n google.script.run.withSuccessHandler(r=>{pollBusy=false;if(requestId!==p.id)return;if(r.done)finishPayment(r,p);else if(r.failed)showPaymentError(r.message);else if(!paymentError)msg(r.message+'\\nNo vuelvas a pasar la tarjeta ni a capturar el pedido.');}).withFailureHandler(()=>{pollBusy=false;}).cajaSimpleEstado(p.id);\n}\nfunction watchPayment(p){if(pollTimer)clearInterval(pollTimer);pollTimer=setInterval(()=>pollPayment(p),5000);}\nfunction sendPayment(p){\n paymentError=\"\";state(true);pendingPayload=p;requestId=p.id;pendingStore(p);msg('Confirmando la operación… Consultaremos su estado automáticamente. No vuelvas a pasar la tarjeta.');watchPayment(p);\n google.script.run.withSuccessHandler(r=>finishPayment(r,p)).withFailureHandler(e=>{if(requestId!==p.id)return;showPaymentError(e.message||String(e));pollPayment(p);}).cajaSimpleRegistrar(p);\n}\nfunction restorePayment(){\n let p;try{p=JSON.parse(localStorage.getItem('DOMUS_PENDING_PAYMENT')||'null');}catch(e){return;}\n if(!p||!/^POS-/.test(p.id))return;pendingPayload=p;requestId=p.id;cart=p.items||[];\n if(p.ticket&&!data.accounts.some(a=>a.ticket===p.ticket))$('account').add(new Option(p.customer+' · operación por verificar',p.ticket));$('account').value=p.ticket||'';\n $('customer').value=p.customer;$('activity').value=p.activity;$('credit').value=p.credit||'';$('method').value=p.method;$('received').value=p.received===null?'':p.received;$('tip').value=p.tip||0;render();$('total').textContent=money(p.expectedTotal);if(p.method==='Efectivo')$('change').textContent=money(Number(p.received)-Number(p.expectedTotal)-Number(p.tip||0));state(true);busy=false;$('pay').disabled=false;$('pay').textContent='Retomar misma operación';msg('Recuperamos tu operación anterior. Verificando si el pago ya quedó registrado…');watchPayment(p);pollPayment(p);\n}\nfunction submit(paid){\n if(busy||!data)return;if(pendingPayload){sendPayment(pendingPayload);return;}\n if(!$('customer').value.trim()){msg('Escribe el nombre y apellido o apodo.','error');return;}\n if(!cart.length&&!$('account').value){msg('Agrega un producto o elige una cuenta.','error');return;}\n const cash=$('method').value==='Efectivo',total=due(),rec=Number($('received').value),tip=Number($('tip').value);\n if(paid&&cash&&total>0&&($('received').value===''||!Number.isFinite(rec)||!Number.isFinite(tip)||tip<0||rec<total+tip)){msg('El efectivo recibido debe cubrir la venta y la propina voluntaria.','error');return;}\n requestId='POS-'+Date.now()+'-'+Math.random().toString(36).slice(2);\n sendPayment({id:requestId,ticket:$('account').value,customer:$('customer').value.trim(),activity:$('activity').value,phase:data.phase,items:cart,credit:$('credit').value,paid,method:$('method').value,received:cash?rec:null,tip:cash?tip:0,expectedTotal:total});\n}\nfunction fresh(){if(busy||pendingPayload)return;cart=[];requestId=null;$('consumption').value='Normal';$('group').value='';$('search').value='';products();$('account').value='';$('received').value='';$('tip').value='0';choose();render();msg('Nueva venta. Elige los productos y después registra el pago recibido.');}load();\n</script></body></html>\n";
/** Caja simple: interfaz operativa sobre el mismo libro y el mismo registro de cobros. */
function abrirCajaSimple(){SpreadsheetApp.getUi().showModalDialog(HtmlService.createHtmlOutput(DOMUS_CAJA_SIMPLE_HTML).setWidth(1040).setHeight(730),'DOMUS · Caja simple');}
function cajaSimpleDatos(){
 const m=SpreadsheetApp.openById(D.main),s=m.getSheetByName('CAJA 2'),phase=String(s.getRange('F2').getValue());
 if(!['Solar','Lunar'].includes(phase))throw Error('Steven o Angel deben elegir Solar/Lunar en Caja 2.');
 const cat=m.getSheetByName('CATALOGO').getRange('A7:T306').getValues();
 const products=posCatalogRows_(cat).map(r=>({name:r[0],group:r[1],price:r[15]?r[phase==='Solar'?16:17]:r[2]})).filter(p=>typeof p.price==='number'&&p.price>=0);
 const map=new Map();for(const r of s.getRange(7,1,D.count,16).getValues())if(r[1]&&r[6]&&r[15]!=='Cancelado'){
  const key=String(r[1]);let a=map.get(key);if(!a){a={ticket:key,customer:String(r[4]||''),activity:String(r[3]||'Visita general DOMUS'),due:0};map.set(key,a);}a.due+=Number(r[11])||0;
 }
