 if(payment[4]==='Transferencia'&&Number(payment[13])<=0){source.setNote('POR VERIFICAR:'+JSON.stringify(meta)).setValue(false);return {receipt:meta.folio,paid:false,notice:'Transferencia '+meta.folio+' pendiente de verificación de Steven. No repetir.'};}
 if(Number(payment[13])<=0)throw Error('El registro aún no se aplica: '+String(payment[12]||'en revisión')+'. Conserva la referencia.');
 if(payment[4]==='Efectivo')Object.assign(meta,{received:Number(payment[29]),tip:Number(payment[28]),change:Number(payment[30])});
 source.setNote('REGISTRADO:'+JSON.stringify(meta)).setValue(true);payments[index]=payment;
 return {receipt:meta.folio,paid:true,notice:'PAGO REGISTRADO '+meta.folio+' · $'+Number(payment[13]).toFixed(2)+' · '+payment[4]};
}
function cajaSimplePreparar(id){
 if(!/^POS-[A-Za-z0-9-]{8,100}$/.test(String(id)))throw Error('Referencia inválida.');
 const result=backgroundLock_(()=>{const props=PropertiesService.getScriptProperties(),key='cajaSimple:'+id,job=JSON.parse(props.getProperty(key)||'null');if(!job)return {pending:true};const x=ctx_(),b=balance_(x,job.ticket),a=account_(job.ticket);if(b.due>.01&&(!a.credit||!['Amigo','Creador de proyecto'].includes(a.customerType)))return {pending:true};const rec=records_(x),pending=b.rows.some(r=>!rec.some(z=>z&&z.id===r[0]));const sent=pending?dispatch_(x,job.first,Session.getActiveUser().getEmail()||'Caja',true):0;updateFeeAllocations_(x);job.postPending=false;props.setProperty(key,JSON.stringify(job));return {pending:false,sent};});return result||{pending:true};
}
