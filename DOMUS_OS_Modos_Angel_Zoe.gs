function guardPendingTransfer_(payments,origin,ticket){if(payments.some(p=>p[2]===origin&&String(p[3])===String(ticket)&&p[4]==='Transferencia'&&p[10]==='Borrador'&&Number(p[5])>0))throw Error('Ya hay una transferencia por verificar para esta cuenta. Steven debe confirmarla o anularla antes de otro cobro.');}
function transferStamp_(p){return 'VERIFICADO|direccion@domusccc.net|'+[p[2],String(p[3]),Number(p[5]).toFixed(2),p[8],Utilities.formatDate(p[1],'America/Mexico_City','yyyy-MM-dd')].join('|')+'|';}
function holdTransferReceipt_(x,source,row,col,ledgerRow){const cob=x.m.getSheetByName('COBROS'),p=cob.getRange(ledgerRow,1,1,20).getValues()[0],meta={folio:p[0],method:p[4],amount:p[5],ticket:String(p[3]),tag:p[8],wardrobeQty:source.getName()==='ACCESO'?Number(source.getRange(row,9).getValue()):undefined};if(source.getName()==='ACCESO')Object.assign(meta,accessReceiptContext_(x,row));source.getRange(row,col).setNote('POR VERIFICAR:'+JSON.stringify(meta)).setValue(false);x.m.toast('Transferencia '+p[0]+' por verificar con Steven. Aún no cuenta como pagada.','DOMUS',10);}
function refreshPendingTransfer_(x,source,row,col){const cell=source.getRange(row,col),note=cell.getNote();if(!note.startsWith('POR VERIFICAR:'))return '';const meta=JSON.parse(note.slice('POR VERIFICAR:'.length)),cob=x.m.getSheetByName('COBROS'),p=cob.getRange(expandedA1_('A7:T506')).getValues().find(p=>p[8]===meta.tag);if(!p){cell.setValue(false);return 'pending';}if(p[10]==='Anulado'){cell.setValue(false).clearNote();return 'canceled';}if(p[10]==='Confirmado'&&Number(p[13])>0&&String(p[19]).startsWith(transferStamp_(p))){cell.setNote('REGISTRADO:'+JSON.stringify(meta)).setValue(true);return 'confirmed';}cell.setValue(false);return 'pending';}
function syncPendingTransfersCore_(x){for(const [source,col] of [[x.c,35],[x.m.getSheetByName('ACCESO'),29]]){const notes=source.getRange(7,col,D.count,1).getNotes();for(let i=0;i<D.count;i++)if(notes[i][0].startsWith('POR VERIFICAR:'))refreshPendingTransfer_(x,source,i+7,col);}}
function confirmTransferRow_(x,row,who,evidence){if(who!=='direccion@domusccc.net')throw Error('Solo Steven verifica las transferencias.');if(!String(evidence||'').trim())throw Error('Anota la referencia que Steven verificó en la cuenta bancaria.');const cob=x.m.getSheetByName('COBROS'),p=cob.getRange(row,1,1,20).getValues()[0];if(p[4]!=='Transferencia'||Number(p[5])<=0||p[10]==='Anulado')throw Error('Selecciona una transferencia vigente con importe positivo.');validateSingleMethod_(cob.getRange(expandedA1_('A7:Q506')).getValues(),p[2],p[3],p[4]);if(p[2]==='Caja'&&Number(p[5])>balance_(x,String(p[3])).due+(Number(p[13])||0)+0.01)throw Error('La transferencia supera el saldo de la cuenta.');if(p[2]==='Acceso'){const due=x.m.getSheetByName('ACCESO').getRange(expandedA1_('A7:P506')).getValues().find(r=>String(r[0])===String(p[3]));if(!due||Number(p[5])>Number(due[15])+(Number(p[13])||0)+0.01)throw Error('La transferencia supera el saldo del acceso.');}const stamp=transferStamp_(p);if(p[10]==='Confirmado'&&Number(p[13])>0&&String(p[19]).startsWith(stamp))return;const old=p[10],oldStamp=p[19];cob.getRange(row,20).setValue(stamp+new Date().toISOString()+'|'+String(evidence).trim());cob.getRange(row,11).setValue('Confirmado');SpreadsheetApp.flush();if(Number(cob.getRange(row,14).getValue())<=0){cob.getRange(row,11).setValue(old);cob.getRange(row,20).setValue(oldStamp);throw Error('No se aplica: '+cob.getRange(row,13).getDisplayValue());}cob.getRange(row,20).setNote('Steven comprobó recepción en banco. '+evidence);}
