 for(const r of rec)if(r&&!['Entregada','Cancelada'].includes(r.state))(groups[r.batch||r.id]||(groups[r.batch||r.id]=[])).push(r);
 for(const group of Object.values(groups)){
  const known=group.find(r=>r.responsible),requested=group.map(r=>String(inputs[r.row-7][0]||'').trim()).filter(Boolean),owner=known?known.responsible:requested.find(v=>team.has(v));
