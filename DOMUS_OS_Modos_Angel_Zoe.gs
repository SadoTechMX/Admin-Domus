   if(cat[18]!=='Sí'||typeof price!=='number'){x.c.getRange(row,10).clearContent();x.c.getRange(row,16).setValue('Borrador').setNote('Producto no disponible en '+phase);return;}
   x.c.getRange(row,10).setValue(price);x.c.getRange(row,18,1,2).setValues([[cat[3],cat[4]]]);
   x.c.getRange(row,21).setValue(cat[6]);x.c.getRange(row,25).setValue(cat[7]);
  }
 }
 prepareCashRowLegacy_(x,row);
 const ticket=String(x.c.getRange(row,2).getValue());
 if(ticket){const first=x.c.getRange(expandedA1_('B7:E506')).getValues().find((v,i)=>i+7!==row&&String(v[0])===ticket&&v[2]);if(first)x.c.getRange(row,4).setValue(first[2]);}
