function prepareCashRowLegacy_(x,row){const r=x.c.getRange(row,1,1,32).getValues()[0];if(!r[6])return;const set=(col,value)=>x.c.getRange(row,col).setValue(value);if(!r[2]){const today=Utilities.formatDate(new Date(),'America/Mexico_City','yyyy-MM-dd');set(3,Utilities.parseDate(today,'America/Mexico_City','yyyy-MM-dd'));}if(!r[3])set(4,'Operación diaria');if(r[7]==='')set(8,1);if(!r[8])set(9,'Normal');if(!assignCashAccount_(x,row))return;if(['Cuenta amigo','Cuenta creador'].includes(r[15])){try{openAccountFromCash_(x,row);}catch(err){set(16,'Borrador');x.c.getRange(row,16).setNote(String(err.message||err));x.m.toast(String(err.message||err),'Cuenta no abierta',10);}}}
function autoDispatch_(x,who){let rec=records_(x),all=x.c.getRange(7,1,D.count,32).getValues();const payments=x.m.getSheetByName('COBROS').getRange(7,1,D.count,14).getValues(),states=PropertiesService.getScriptProperties().getProperties(),balances=new Map();for(const v of all)if(v[1]&&v[6]&&v[15]!=='Cancelado')balances.set(String(v[1]),(balances.get(String(v[1]))||0)+(Number(v[11])||0));for(const v of payments)if(v[2]==='Caja')balances.set(String(v[3]),(balances.get(String(v[3]))||0)-(Number(v[13])||0));const tickets=new Map();for(let i=0;i<all.length;i++){const r=all[i];if(rec[i]||!r[6]||!['Enviar','Cuenta amigo','Cuenta creador'].includes(r[15]))continue;if(r[1]&&(balances.get(String(r[1]))||0)>.01){const a=JSON.parse(states[key_(String(r[1]))]||'{}');if(!a.credit||!['Amigo','Creador de proyecto'].includes(a.customerType)){if(!['Cuenta amigo','Cuenta creador'].includes(r[15]))continue;}}prepareCashRow_(x,i+7);if(r[1]===''){x.c.getRange(i+7,16).setNote('Falta TICKET / CUENTA.');continue;}const t=String(r[1]);if(!tickets.has(t))tickets.set(t,i+7);}SpreadsheetApp.flush();for(const [ticket,row] of tickets){try{dispatch_(x,row,who,true);const latest=records_(x);for(const r of latest)if(r&&r.ticket===ticket)x.c.getRange(r.row,16).setNote('ENVIADO A '+r.destination+' · '+r.sent);}catch(err){const msg=String(err.message||err);for(let i=0;i<all.length;i++)if(!rec[i]&&String(all[i][1])===ticket&&all[i][15]==='Enviar')x.c.getRange(i+7,16).setNote(msg);x.m.toast(msg,'No enviado · cuenta '+ticket,8);}}}
function activarFlujoFacilDOMUS(){manager_();lock_(()=>{const x=ctx_();x.c.getRange('A5').setValue('1 Cuenta y cliente  →  2 Producto  →  3 Registrar cobro en COBROS  →  4 Elegir Enviar. Llega automáticamente a barra.');x.c.getRange('P6').setValue('ENVIAR A BARRA');x.c.getRange('O6').setValue('ESTADO / QUÉ FALTA');x.s.getRange('A5').setNote('Vista de seguimiento. No es necesario entrar aquí para enviar: usa Enviar en CAJA 2.');x.b.getRange('A4').setValue('Pedidos nuevos: arriba. Marca Entregado una sola vez. Si falta producto, elige el motivo.');autoDispatch_(x,'Activación de envío automático');process_(x,'Activación');});console.log('Envío automático activado.');}
function probarAutoDOMUS(){manager_();lock_(()=>{const x=ctx_(),cob=x.m.getSheetByName('COBROS'),p=PropertiesService.getScriptProperties(),ticket='AUDIT-AUTO-20261020';if(x.c.getRange('G506').getValue()||cob.getRange('F506').getValue()||records_(x)[499])throw Error('Fila de prueba ocupada');const ranges=[x.c.getRange('A506:AF506'),cob.getRange('A506:Q506'),x.s.getRange('H506'),x.s.getRange('M506:N506'),x.b.getRange('A506:L506'),x.h.getRange('A506:L506')];const backup=ranges.map(r=>({r,v:r.getValues().map((a,i)=>a.map((v,j)=>r.getFormulas()[i][j]||v)),n:r.getNotes()}));const check=(ok,msg)=>{if(!ok)throw Error(msg);console.log('PASS '+msg);};try{x.c.getRange('B506').setValue(ticket);x.c.getRange('E506:F506').setValues([['AUDITORÍA NO PREPARAR','Barra']]);SpreadsheetApp.flush();x.c.getRange('G506').setValue('Carta Blanca · BAR-004');x.c.getRange('P506').setValue('Enviar');autoDispatch_(x,'Prueba automática');check(!records_(x)[499],'Sin pago no se envía');check(x.c.getRange('H506').getValue()===1&&x.c.getRange('I506').getValue()==='Normal'&&x.c.getRange('C506').getValue() instanceof Date,'Fecha cantidad y tipo automáticos');cob.getRange('B506:G506').setValues([[x.c.getRange('C506').getValue(),'Caja',ticket,'Efectivo',50,0]]);cob.getRange('K506:L506').setValues([['Confirmado','PRUEBA SIMULADA']]);SpreadsheetApp.flush();autoDispatch_(x,'Prueba automática');check(records_(x)[499].state==='Pendiente'&&x.b.getRange('B506').getValue()===ticket,'El pago posterior libera el envío');const sent=records_(x)[499].sent;autoDispatch_(x,'Reintento');check(records_(x)[499].sent===sent&&records_(x)[499].events.filter(e=>e.action==='Enviar').length===1,'Sin envío duplicado');check(x.c.getRange('V506').getValue()===0,'Sin entrega no consume inventario');}finally{for(const b of backup){b.r.setValues(b.v);b.r.setNotes(b.n);}x.b.hideRows(506);p.deleteProperty(key_(ticket));SpreadsheetApp.flush();console.log('Prueba retirada.');}});}

