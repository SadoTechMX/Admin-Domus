function probarReglasDOMUS(){const assert=(v,m)=>{if(!v)throw Error(m);};const r={state:'Pendiente',events:[]};assert(transition_(r,true,'','Prueba'),'Entrega');assert(r.state==='Entregada','Estado');assert(!transition_(r,true,'','Prueba'),'Duplicado');assert(r.events.length===1,'Sin doble consumo');const c={state:'Cancelada',events:[]};assert(!transition_(c,true,'','Prueba'),'Cancelación no entregable');const n={state:'Pendiente',events:[]};assert(transition_(n,false,'Agotado en DOMUS','Prueba'),'Agotado');assert(n.state==='Pendiente','No cancela ni cobra');assert(!transition_(n,false,'Agotado en DOMUS','Prueba'),'Incidencia duplicada');const row=Array(32).fill('');row[1]='T1';row[4]='Cliente';row[7]=1;row[22]='LISTO';validateDispatch_([row],{credit:true},{due:100});let blocked=false;try{validateDispatch_([row],{},{due:100});}catch(e){blocked=true;}assert(blocked,'Bloqueo sin cobro ni crédito');row[7]=3;blocked=false;try{validateDispatch_([row],{credit:true},{due:100});}catch(e){blocked=true;}assert(blocked,'Una unidad por fila');console.log('8 reglas verificadas. Esta prueba no escribe ventas ni cobros.');}

function pruebaIntegracionDOMUS(){manager_();lock_(()=>{const x=ctx_(),rows=[505,endRow_()],ticket='PRUEBA-DOMUS-20261020',cob=x.m.getSheetByName('COBROS'),props=PropertiesService.getScriptProperties();if(records_(x).some(Boolean))throw Error('La prueba requiere una matriz sin comandas enviadas.');if(x.c.getRange(expandedA1_('B505:I506')).getValues().flat().some(v=>v!==''))throw Error('Filas de prueba ocupadas.');if(cob.getRange(expandedA1_('B505:G506')).getValues().flat().some(v=>v!==''))throw Error('Filas de cobro de prueba ocupadas.');const backup=[];for(const range of [x.c.getRange(expandedA1_('A505:AF506')),cob.getRange(expandedA1_('A505:Q506')),x.s.getRange(expandedA1_('H505:H506')),x.s.getRange(expandedA1_('M505:N506')),x.b.getRange(expandedA1_('A505:L506')),x.h.getRange(expandedA1_('A505:L506')),x.r.getRange('A7:H10')]){const values=range.getValues(),f=range.getFormulas();backup.push({range,data:values.map((r,i)=>r.map((v,j)=>f[i][j]||v))});}const oldProps=props.getProperties(),check=(v,m)=>{if(!v)throw Error('PRUEBA: '+m);};try{try{for(const row of rows){x.c.getRange(row,2,1,5).setValues([[ticket,new Date(2026,9,20,12),'Operación diaria','PRUEBA TEMPORAL','Barra']]);x.c.getRange(row,8,1,2).setValues([[1,'Normal']]);SpreadsheetApp.flush();x.c.getRange(row,7).setValue('Carta Blanca · BAR-004');x.c.getRange(row,16).setValue('Borrador');}SpreadsheetApp.flush();let blocked=false;try{dispatch_(x,505,'Prueba');}catch(e){blocked=String(e).includes('Registra el cobro');}check(blocked,'rechazar envío sin cobro ni crédito');putAccount_(ticket,{credit:true});check(dispatch_(x,505,'Prueba')===2,'enviar lote de dos unidades');check(dispatch_(x,505,'Prueba')===0,'no duplicar');}catch(e){if(!String(e).includes('No hay unidades nuevas'))throw e;}
let rec=records_(x);check(rec[498]&&rec[499],'registros de envío');check(x.b.getRange('F505').getValue()==='Carta Blanca · BAR-004','producto en barra');x.b.getRange(expandedA1_('I505:I506')).setValues([['Reponer de almacén'],['Reponer de almacén']]);process_(x,'Prueba de operación');rec=records_(x);check(rec[498].request===rec[499].request,'agrupar solicitud por producto');const q=JSON.parse(props.getProperty(requestKey_('Carta Blanca · BAR-004','Reponer de almacén')));check(x.r.getRange(q.row,5).getValue()===2,'dos unidades pendientes');x.r.getRange(q.row,6).setValue(true);process_(x,'Prueba de inventario');check(x.c.getRange('V505').getValue()===0,'resurtido no descuenta inventario');x.b.getRange(expandedA1_('H505:H506')).setValues([[true],[true]]);process_(x,'Prueba de operación');process_(x,'Reintento de prueba');SpreadsheetApp.flush();rec=records_(x);check(rec[498].events.filter(e=>e.action==='Entregar').length===1,'entrega idempotente');check(x.c.getRange(expandedA1_('V505:V506')).getValues().every(r=>r[0]===1),'consumo unitario');check(x.h.getRange('J505').getValue()==='Entregada','historial');for(const row of rows){cob.getRange(row,2,1,6).setValues([[new Date(2026,9,20,12),'Caja',ticket,'Efectivo',50,0]]);cob.getRange(row,11,1,2).setValues([['Confirmado','PRUEBA TEMPORAL']]);}SpreadsheetApp.flush();check(balance_(x,ticket).due===0,'dos abonos liquidan cuenta');rec[498].state='Pendiente';rec[498].delivered=null;event_(rec[498],'Revertir entrega','Prueba','Prueba reversible');save_(x,rec[498]);x.b.getRange('H505').setValue(false);publish_(x,rec[498]);SpreadsheetApp.flush();check(x.c.getRange('V505').getValue()===0,'corrección revierte consumo');rec[498].state='Cancelada';save_(x,rec[498]);publish_(x,rec[498]);SpreadsheetApp.flush();check(x.c.getRange('L505').getValue()===0,'cancelación anula importe');console.log('INTEGRACIÓN CORRECTA: crédito, lote, duplicados, resurtido agrupado, entrega, inventario, historial, abonos y corrección.');}finally{for(const b of