  const rows=rec.filter(r=>r&&r.state!=='Cancelada'&&(r.responsible||r.preparedBy)===name),done=rows.filter(r=>r.state==='Entregada'),groups={};
  for(const r of rows)(groups[r.batch||r.id]||(groups[r.batch||r.id]=[])).push(r);
  const wait=rows.filter(r=>r.preparedAt).map(r=>Math.max(0,(new Date(r.preparedAt)-new Date(r.sent))/60000)),time=done.filter(r=>r.preparedAt&&r.delivered).map(r=>Math.max(0,(new Date(r.delivered)-new Date(r.preparedAt))/60000));
