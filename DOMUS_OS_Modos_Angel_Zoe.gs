const p=x.s.getRange('M7:N506').protect().setDescription('DOMUS registros de sincronización');p.addEditors(D.managers);p.removeEditors(p.getEditors().filter(u=>!D.managers.includes(u.getEmail())));if(p.canDomainEdit())p.setDomainEdit(false);
