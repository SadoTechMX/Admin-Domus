 });}finally{const finalTest=props.getProperty('finalOpeningTest20261020'),capacity=props.getProperty('domusCapacity');for(const k of Object.keys(props.getProperties()))if(!(k in prior))props.deleteProperty(k);props.setProperties(prior);if(capacity)props.setProperty('domusCapacity',capacity);if(finalTest)props.setProperty('finalOpeningTest20261020',finalTest);D.main=previous.main;D.ops=previous.ops;D.count=Number(capacity||previous.count);}
