function dispatch_(x,row,who,onlyRequested){const all=x.c.getRange(7,1,D.count,32).getValues(),ticket=String(all[row-7][1]);if(!ticket)throw Error('Falta folio de cuenta.');const rec=records_(x);const indices=all.map((r,i)=>String(r[1])===ticket&&r[6]&&r[15]!=='Cancelado'&&(!onlyRequested||r[15]==='Enviar')&&!rec[i]?i:-1).filter(i=>i>=0);const oldStates=indices.map(i=>all[i][15]);for(const i of indices)x.c.getRange(i+7,16).setValue('Enviar');SpreadsheetApp.flush();for(const i of indices)all[i]=x.c.getRange(i+7,1,1,32).getValues()[0];const a=account_(ticket);try{validateDispatch_(indices.map(i=>all[i]),a,balance_(x,ticket));}catch(err){indices.forEach((i,j)=>x.c.getRange(i+7,16).setValue(oldStates[j]));throw err;}for(const i of indices){x.b.getRange(i+7,8,1,2).setValues([['','']]);x.b.getRange(i+7,13).clearContent();}const now=new Date().toISOString(),batch=Utilities.getUuid(),recipeBook=recipeBook_(x);for(const i of indices){const r=all[i];rec[i]={id:r[0],row:i+7,ticket,alias:String(r[4]),product:r[6],notes:String(r[16]||''),destination:r[24],sent:now,batch,state:'Pendiente',credit:!!a.credit,snap:snapshot_(r,recipeBook),events:[]};event_(rec[i],'Enviar',who,a.credit?'Crédito autorizado':'Cobro registrado');}x.s.getRange(7,13,D.count,1).setValues(rec.map(r=>[r?JSON.stringify(r):'']));SpreadsheetApp.flush();for(const i of indices)publish_(x,rec[i]);x.m.toast(indices.length+' unidades enviadas.','DOMUS');return indices.length;}
