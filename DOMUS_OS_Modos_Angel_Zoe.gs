function posSignature_(value){const canonical=v=>Array.isArray(v)?v.map(canonical):v&&typeof v==='object'?Object.keys(v).sort().reduce((r,k)=>{r[k]=canonical(v[k]);return r;},{}):v;return JSON.stringify(canonical(value));}
function cajaSimpleRegistrar(p){try{if(p&&/^POS-[A-Za-z0-9-]{8,100}$/.test(String(p.id)))PropertiesService.getScriptProperties().deleteProperty('cajaSimpleError:'+p.id);return cajaSimpleRegistrarCore_(p);}catch(e){if(p&&/^POS-[A-Za-z0-9-]{8,100}$/.test(String(p.id))){const props=PropertiesService.getScriptProperties(),key='cajaSimple:'+p.id,j=JSON.parse(props.getProperty(key)||'null');props.setProperty('cajaSimpleError:'+p.id,String(e.message||e));if(j&&!j.done){j.lastError=String(e.message||e);props.setProperty(key,JSON.stringify(j));}}throw e;}}
function recuperarPedidoLeoExistente(){manager_();const id='POS-1792550849395-acs5vjsvq6n',j=JSON.parse(PropertiesService.getScriptProperties().getProperty('cajaSimple:'+id)||'null');if(!j||j.customer!=='LEO LEONIDAS'||j.base!==50)throw Error('No coincide la operación original.');const p=JSON.parse(j.signature),reordered=Object.fromEntries(Object.entries(p).reverse());if(posSignature_(p)!==posSignature_(reordered))throw Error('Firma inestable.');console.log('PASS referencia estable al reordenar campos.');const at=Date.now(),r=cajaSimpleRegistrar(reordered);console.log('RECUPERACIÓN ORIGINAL '+((Date.now()-at)/1000).toFixed(1)+' s · '+JSON.stringify(r));}

