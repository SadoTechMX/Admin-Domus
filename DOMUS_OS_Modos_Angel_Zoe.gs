function prepareCashRow_(x,row){
 const range=x.c.getRange(row,1,1,38),r=range.getValues()[0];if(!r[6])return;
 const cat=x.m.getSheetByName('CATALOGO').getRange('A7:T').getValues().find(v=>v[0]===r[6]);
 if(!cat)throw Error('Producto no encontrado en catálogo.');
 if(!r[3])x.c.getRange(row,4).setValue('Visita general DOMUS');
 if(cat[15]){
  const phase=r[36]||menuPhase_(x),price=cat[phase==='Solar'?16:17];
  x.c.getRange(row,37).setValue(phase);
