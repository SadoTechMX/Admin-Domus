function changeManager_(action){ui_(()=>{const who=manager_(),row=selected_(),reason=prompt_(action);if(reason===null)return;lock_(()=>{const x=ctx_(),r=records_(x)[row-7];if(!r)throw Error('Esta unidad aún no se ha enviado.');if(account_(r.ticket).closed)throw Error('Reabre la cuenta antes de corregirla.');if(action==='Cancelar'){if(r.state==='Entregada')throw Error('Corrige primero la entrega. Si hubo consumo o merma, regístralo en inventario.');r.state='Cancelada';r.incident='';}else{if(r.state!=='Entregada')throw Error('La unidad no está entregada.');r.state=r.preparedAt?'Lista':'Pendiente';r.delivered=null;r.deliveredBy='';r.incident='';}event_(r,action,who,reason);save_(x,r);x.b.getRange(row,8,1,2).setValues([[r.preparedBy||'','']]);x.b.getRange(row,13).clearContent();publish_(x,r);refreshRequests_(x,records_(x));updateIngredientUsage_(x,records_(x));});});}
function transition_(r,delivered,incident,who){if(r.state==='Entregada'||r.state==='Cancelada')return false;if(delivered===true){r.state='Entregada';r.delivered=new Date().toISOString();r.incident='';event_(r,'Entregar',who);return true;}if(['Reponer de almacén','Agotado en DOMUS'].includes(incident)&&incident!==r.incident){r.incident=incident;event_(r,'No disponible',who,incident);return true;}return false;}
function requestKey_(product,type){return 'resurtido:'+Utilities.base64EncodeWebSafe(product+'|'+type);}
function refreshRequests_(x,rec){const props=PropertiesService.getScriptProperties(),groups={};for(const r of rec){if(r&&['Pendiente','Lista','En preparación'].includes(r.state)&&r.incident){const key=requestKey_(r.product,r.incident);(groups[key]||(groups[key]={product:r.product,type:r.incident,items:[]})).items.push(r);}}const values=props.getProperties();for(const key of Object.keys(groups)){const g=groups[key];let q=JSON.parse(values[key]||'null');if(!q||q.done){let n=Number(props.getProperty('requestNext')||7);if(n>endRow_())throw Error('Se agotaron los espacios de resurtido.');q={id:'RS-'+Utilities.getUuid().slice(0,8),row:n,product:g.product,type:g.type,at:new Date().toISOString(),done:false};props.setProperty('requestNext',String(n+1));props.setProperty(key,JSON.stringify(q));}for(const r of g.items){if(r.request!==q.id){r.request=q.id;save_(x,r);x.b.getRange(r.row,12).setValue(q.id);}}x.r.getRange(q.row,1,1,5).setValues([[q.id,new Date(q.at),g.product,g.type,g.items.length]]);x.r.getRange(q.row,8).setValue(g.type==='Agotado en DOMUS'?'Compra pendiente':'Resurtido pendiente');}
for(const key of Object.keys(values).filter(k=>k.startsWith('resurtido:'))){const q=JSON.parse(values[key]);if(!q.done&&!groups[key]){x.r.getRange(q.row,5).setValue(0);x.r.getRange(q.row,8).setValue('Sin unidades pendientes');}}
}
function processResurtido_(x,who,rec){const props=PropertiesService.getScriptProperties(),all=props.getProperties();const resolved=x.r.getRange(7,6,D.count,1).getValues();for(const key of Object.keys(all).filter(k=>k.startsWith('resurtido:'))){const q=JSON.parse(all[key]);if(q.done||resolved[q.row-7][0]!==true)continue;q.done=true;q.doneAt=new Date().toISOString();q.by=who;props.setProperty(key,JSON.stringify(q));for(const r of rec){if(r&&r.request===q.id&&['Pendiente','Lista','En preparación'].includes(r.state)){r.incident='';event_(r,'Disponibilidad confirmada',who,q.id);save_(x,r);x.b.getRange(r.row,9).clearContent();publish_(x,r);}}x.r.getRange(q.row,7,1,2).setValues([[new Date(q.doneAt),'Resuelto']]);}
refreshRequests_(x,rec);const stamp='Última sincronización: '+Utilities.formatDate(new Date(),'America/Mexico_City','dd/MM/yyyy HH:mm:ss');x.b.getRange('C3').setValue(stamp);x.r.getRange('A3').setValue(stamp);x.h.getRange('A3').setValue(stamp);}
function domusEdit(e){if(!e||!e.range)return;const id=e.source.getId(),name=e.range.getSheet().getName();if(id===D.ops&&!['COMANDAS','RESURTIDO'].includes(name))return;if(id!==D.ops&&id!==D.main)return;lock_(()=>{const x=ctx_();if(id===D.main&&name==='CAJA 2'){const records=records_(x);if(e.range.getColumn()<=7&&e.range.getLastColumn()>=7){for(let row=Math.max(7,e.range.getRow());row<=Math.min(endRow_(),e.range.getLastRow());row++)if(!records[row-7]){x.c.getRange(row,10).clearContent();x.c.getRange(row,18,1,2).clearContent();x.c.getRange(row,37).clearContent();}}for(let row=Math.max(7,e.range.getRow());row<=Math.min(endRow_(),e.range.getLastRow());row++){if(e.range.getColumn()<=16&&e.range.getLastColumn()>=16&&x.c.getRange(row,16).getValue()==='Cerrar cuenta'){const prior=records[row-7];x.c.getRange(row,16).setValue(prior?(prior.state==='Cancelada'?'Cancelado':'Enviar'):'Borrador');try{closeCashAccount_(x,row,e.user?e.user.getEmail():'Caja');}catch(err){x.c.getRange(row,16).setNote(String(err.message||err));x.m.toast(String(err.message||err),'Cuenta no cerrada',10);}}if(records[row-7])restoreSource_(x,records[row-7]);}}if(id===D.main){syncPendingTransfers_(x);if(name==='CAJA 2')for(let row=Math.max(7,e.range.getRow());row<=Math.min(endRow_(),e.range.getLastRow());row++)if(!records_(x)[row-7])prepareCashRow_(x,row);receiptEdit_(x,e);accessEdit_(x,e);accessCharges_(x,e.user?e.user.getEmail():'Acceso');quickCharge_(x,e.user?e.user.getEmail():'Caja');autoDispatch_(x,e.user?e.user.getEmail():'Caja');}process_(x,id===D.ops?'Cuenta compartida de operación':(e.user?e.user.getEmail():'Caja'));});}
function domusReconcile(){if(PropertiesService.getScriptProperties().getProperty('enabled')!=='true')return;backgroundLock_(()=>{const x=ctx_();syncPendingTransfers_(x);accessCharges_(x,'Recuperación automática');quickCharge_(x,'Recuperación automática');autoDispatch_(x,'Recuperación automática');process_(x,'Cuenta compartida de operación');const mirror=x.b.getRange(7,1,D.count,12).getValues(),mainState=x.s.getRange(7,8,D.count,1).getValues();for(const r of records_(x)){if(r&&(mirror[r.row-7][0]!==r.id||mirror[r.row-7][9]!==r.state||mainState[r.row-7][0]!== (r.state==='Entregada'?'Entregada':r.state==='Cancelada'?'':'Recibida')))publish_(x,r);}});}
