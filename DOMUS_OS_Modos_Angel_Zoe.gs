   if(owner&&!r.responsible){r.responsible=owner;r.preparedBy=owner;r.preparedAt=new Date().toISOString();r.state='En preparación';event_(r,'Atender',owner);changed=true;}
   if(entered!==String(r.responsible||''))x.b.getRange(r.row,8).setValue(r.responsible||'').setNote(entered?'La comanda ya está asignada; quien atiende también entrega.':'');
