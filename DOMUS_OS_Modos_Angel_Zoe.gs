function prepareAccess_(x,row){const s=x.m.getSheetByName('ACCESO'),r=s.getRange(row,1,1,32).getValues()[0];if(!r[3])return;if(!r[1])s.getRange(row,2).setValue(Utilities.parseDate(Utilities.formatDate(new Date(),'America/Mexico_City','yyyy-MM-dd'),'America/Mexico_City','yyyy-MM-dd'));if(!r[2]){const activity=pickAccessActivity_(x,s.getRange(row,2).getValue());if(activity)s.getRange(row,3).setValue(activity);}if(!r[6])s.getRange(row,7).setValue('General');if(r[7]==='')s.getRange(row,8).setValue(1);let qty=r[8]===''?0:Number(r[8]);if(!Number.isInteger(qty)||qty<0)throw Error('Prendas: escribe una cantidad entera de 0 en adelante.');if(r[6]==='Solo guardarropa'&&qty===0)qty=1;if(typeof r[8]!=='number'||r[8]!==qty)s.getRange(row,9).setValue(qty);if(!r[22])s.getRange(row,23).setValue('Registrado');}
function accessEdit_(x,e){if(e.range.getSheet().getName()!=='ACCESO')return;const s=x.m.getSheetByName('ACCESO');for(let row=Math.max(7,e.range.getRow());row<=Math.min(endRow_(),e.range.getLastRow());row++){restorePreventaContext_(x,row,e);restoreAccessReceiptContext_(x,row,e);if(e.range.getColumn()<=2&&e.range.getLastColumn()>=2&&!s.getRange(row,29).getNote().startsWith('REGISTRADO:')&&!s.getRange(row,29).getNote().startsWith('POR VERIFICAR:'))s.getRange(row,3).clearContent();prepareAccess_(x,row);const cell=s.getRange(row,29),note=cell.getNote();if(e.range.getColumn()<=9&&e.range.getLastColumn()>=9&&(note.startsWith('REGISTRADO:')||note.startsWith('POR VERIFICAR:'))){const pending=note.startsWith('POR VERIFICAR:'),last=JSON.parse(note.slice(pending?'POR VERIFICAR:'.length:11)),oldQty=Number(last.wardrobeQty)||0,newQty=Number(s.getRange(row,9).getValue());if(pending||newQty<oldQty){s.getRange(row,9).setValue(oldQty);x.m.toast(pending?'Steven debe verificar o anular la transferencia antes de cambiar prendas.':'Las prendas ya cobradas se conservan. Revisa cancelación o devolución con Steven.','DOMUS');}else if(newQty>oldQty){cell.setValue(false).clearNote();s.getRange(row,28).clearContent();x.m.toast('Prendas adicionales: revisa el saldo y confirma solo el cobro adicional.','DOMUS');continue;}}if(note.startsWith('POR VERIFICAR:')){const meta=JSON.parse(note.slice('POR VERIFICAR:'.length)),status=refreshPendingTransfer_(x,s,row,29);if(status==='pending')s.getRange(row,27,1,3).setValues([[meta.method,meta.amount,false]]);continue;}if(e.range.getLastColumn()>=27&&e.range.getColumn()<=29&&note.startsWith('REGISTRADO:')){const last=JSON.parse(note.slice(11));SpreadsheetApp.flush();const due=Number(s.getRange(row,16).getValue());if(e.range.getColumn()<=28&&due>0.01){cell.setValue(false).clearNote();if(e.range.getLastColumn()<28)s.getRange(row,28).clearContent();}else s.getRange(row,27,1,3).setValues([[last.method,last.amount,true]]);}}if(e.range.getLastRow()>=7&&e.range.getRow()<=506&&e.range.getColumn()<=7&&e.range.getLastColumn()>=7){const needs=s.getRange(expandedA1_('D7:G506')).getValues().some(r=>r[0]&&r[3]==='Preventa')||s.getRange(Math.max(7,e.range.getRow()),7,Math.min(endRow_(),e.range.getLastRow())-Math.max(7,e.range.getRow())+1,1).getValues().some(r=>r[0]==='Preventa');if(needs)s.showColumns(18);else s.hideColumns(18);}}
function accessCharges_(x,who){const s=x.m.getSheetByName('ACCESO');if(s.getMaxColumns()<32)return;const flags=s.getRange(7,29,D.count,1).getValues(),notes=s.getRange(7,29,D.count,1).getNotes();for(let i=0;i<D.count;i++)if(flags[i][0]===true&&!notes[i][0].startsWith('REGISTRADO:')){try{accessChargeRow_(x,i+7,who);}catch(err){s.getRange(i+7,29).setValue(false).setNote(String(err.message||err));x.m.toast(String(err.message||err),'Acceso: cobro no registrado',8);}}}
function accessChargeRowCore_(x,row,who){simpleAccessRow_(x,row);SpreadsheetApp.flush();const s=x.m.getSheetByName('ACCESO'),r=s.getRange(row,1,1,32).getValues()[0],cell=s.getRange(row,29),cob=x.m.getSheetByName('COBROS');let token=cell.getNote();if(token.startsWith('POR VERIFICAR:')){refreshPendingTransfer_(x,s,row,29);return;}if(token.startsWith('REGISTRADO:')){cell.setValue(true);return;}if(!token.startsWith('PENDIENTE:'))token='PENDIENTE:'+Utilities.getUuid();const tag='ACCESO-RAPIDO:'+token.slice(10),payments=cob.getRange(7,1,D.count,17).getValues();let idx=payments.findIndex(p=>p[8]===tag);const amount=Number(r[27]),method=r[26];if(idx<0){if(r[23]!=='LISTO')throw Error('Completa el registro de acceso: '+r[23]);if(!['Efectivo','Terminal 1','Terminal 2','Transferencia'].includes(method))throw Error('Elige medio de pago.');if(!Number.isFinite(amount)||amount<=0||amount>Number(r[15])+0.01)throw Error('El importe debe ser positivo y no superar el saldo de acceso.');validateSingleMethod_(payments,'Acceso',r[0],method);guardPendingTransfer_(payments,'Acceso',r[0]);idx=payments.findIndex(p=>p[5]===''&&p[3]===''&&p[10]==='');if(idx<0)throw Error('COBROS sin espacio.');freezeAccessTariffs_(x,row);cell.setNote(token);SpreadsheetApp.flush();cob.getRange(idx+7,24,1,2).setValues([originalAccessAllocation_(x,row,amount)]);cob.getRange(idx+7,2,1,6).setValues([[r[1],'Acceso',r[0],method,amount,method==='Efectivo'?0:'']]);cob.getRange(idx+7,9).setValue(tag);cob.getRange(idx+7,12).setValue(who||'Acceso');cob.getRange(idx+7,11).setValue(method==='Transferencia'?'Borrador':'Confirmado');}else if(payments[idx][10]==='Anulado'){throw Error('Cobro anulado. Solicita revisión de Steven.');}else if(payments[idx][4]!=='Transferencia'&&payments[idx][10]!=='Confirmado')cob.getRange(idx+7,11).setValue('Confirmado');SpreadsheetApp.flush();if(cob.getRange(idx+7,5).getValue()==='Transferencia'&&Number(cob.getRange(idx+7,14).getValue())<=0){holdTransferReceipt_(x,s,row,29,idx+7);return;}if(Number(cob.getRange(idx+7,14).getValue())<=0)throw Error('Revisa COBROS: '+cob.getRange(idx+7,13).getDisplayValue());cell.setNote('REGISTRADO:'+JSON.stringify({folio:cob.getRange(idx+7,1).getDisplayValue(),method:cob.getRange(idx+7,5).getValue(),amount:cob.getRange(idx+7,6).getValue(),wardrobeQty:Number(r[8]),...accessReceiptContext_(x,row)})).setValue(true);}
