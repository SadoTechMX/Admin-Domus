 const ranges=[x.c.getRange(1007,2,n,6),x.c.getRange(1007,16,n,1),x.m.getSheetByName('ACCESO').getRange(1007,2,n,8),x.m.getSheetByName('COBROS').getRange(1007,2,n,6),x.s.getRange(1007,13,n,1)];
